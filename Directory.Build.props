<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.10.0</Version>
    <!-- Crimson Desert version the release was verified against; shown next to the app version. -->
    <GameVersion>2.06.00</GameVersion>
    <!-- false builds the editor without online updates (the Nexus Mods package): src/CDSE.App/Updates/ and its
         tests are left out, so the program never contacts GitHub. Set with -p:OnlineUpdate=false or Build.ps1 -NoOnlineUpdate. -->
    <OnlineUpdate Condition="'$(OnlineUpdate)' == ''">true</OnlineUpdate>
    <Authors>geonuz</Authors>
    <Product>CDSE — Crimson Desert Save Editor</Product>
    <Copyright>CDSE contributors. See licenses for inherited components.</Copyright>
  </PropertyGroup>
</Project>
