<UserControl x:Class="CDSE.App.ChallengePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:CDSE.App">
 <Grid IsEnabled="{Binding CanEditSelection}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <local:PageHeader HelpTopic="Challenges" LoadedState="{Binding Challenges, Converter={x:Static local:PresentConverter.Shared}}"><local:PageHeader.LoadButton><Button x:Name="LoadData" Content="{local:Tr ui.load_data}" Command="{Binding LoadChallengesCommand}"/></local:PageHeader.LoadButton>
   <CheckBox x:Name="Incomplete" Content="{local:Tr challenge.incomplete}" VerticalAlignment="Center" Margin="0,0,12,0" Checked="OnFilter" Unchecked="OnFilter"/>
   <Label Content="{local:Tr 'Search:'}" Target="{Binding ElementName=Search}" Margin="0,0,12,0"/>
   <TextBox x:Name="Search" Tag="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" TextChanged="OnSearch" ToolTip="{local:Tr challenge.search}" AutomationProperties.Name="{local:Tr challenge.search}"/>
  </local:PageHeader>
  <DockPanel Grid.Row="1" Style="{StaticResource CountRow}"><TextBlock x:Name="Count" Text="{local:Tr challenge.load_prompt}" Style="{StaticResource CountText}"/></DockPanel>
  <!-- Like the map's places tab: each side has its title above and its action below, in shared rows. -->
  <Grid Grid.Row="2" Grid.IsSharedSizeScope="True">
   <Grid.ColumnDefinitions><ColumnDefinition Width="440*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="850*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="4,0,22,8">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto" SharedSizeGroup="Counts"/><ColumnDefinition Width="Auto" SharedSizeGroup="States"/></Grid.ColumnDefinitions>
     <TextBlock Text="{local:Tr Challenges}" FontWeight="Bold"/>
     <!-- Canvas keeps long translated headers ("Completed / Total") from widening the shared columns; the text overflows left instead. -->
     <Canvas Grid.Column="1"><TextBlock Canvas.Right="8" Text="{local:Tr challenge.count}"/></Canvas><TextBlock Grid.Column="2" Text="{local:Tr Status}" Margin="8,0"/>
    </Grid>
    <TreeView x:Name="Tree" Grid.Row="1" SelectedItemChanged="OnSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" ItemContainerStyle="{StaticResource TableTreeItem}">
     <TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding Children}">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto" SharedSizeGroup="Counts"/><ColumnDefinition Width="Auto" SharedSizeGroup="States"/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" MinWidth="80"/>
       <TextBlock Grid.Column="1" Text="{Binding Count}" Margin="8,0" HorizontalAlignment="Right"/><TextBlock Grid.Column="2" Text="{Binding Status}" Margin="8,0" Style="{StaticResource StatusText}"/>
      </Grid>
     </HierarchicalDataTemplate></TreeView.ItemTemplate>
    </TreeView>
   <!-- Every challenge the tree shows (after the filters) that can be completed here. -->
   <Button Style="{StaticResource BulkButton}" x:Name="CompleteEvery" Grid.Row="2" Content="{local:Tr challenge.complete_every}" IsEnabled="False" Click="OnCompleteEvery" ToolTip="{local:Tr challenge.complete_every_hint}" Margin="0,8,0,0"/>
   <GridSplitter Grid.Column="1" Grid.RowSpan="4" Width="6" HorizontalAlignment="Center" ResizeBehavior="PreviousAndNext"/>
   <TextBlock x:Name="Title" Grid.Column="2" Text="{local:Tr challenge.select}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <DataGrid x:Name="Rows" Grid.Column="2" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"
     EnableRowVirtualization="True" SelectionChanged="OnRowsSelected">
    <DataGrid.Columns>
     <DataGridTextColumn Header="{local:Tr challenge.role}" Binding="{Binding Role}"/>
     <DataGridTextColumn Header="{local:Tr Key}" Binding="{Binding Key}"/>
     <DataGridTextColumn Header="{local:Tr challenge.objective}" Binding="{Binding Name}" Width="*" MinWidth="140">
      <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding InternalName}"/></Style></DataGridTextColumn.ElementStyle>
     </DataGridTextColumn>
     <DataGridTextColumn Header="{local:Tr Status}" Binding="{Binding Status}" ElementStyle="{StaticResource StatusText}"/>
     <DataGridTextColumn Header="{local:Tr Progress}" Binding="{Binding Progress}"/>
    </DataGrid.Columns>
   </DataGrid>
   <WrapPanel Grid.Column="2" Grid.Row="2" Margin="0,8,0,0">
    <Button Style="{StaticResource AccentButton}" x:Name="CompleteAll" Content="{local:Tr challenge.complete_all}" IsEnabled="False" Click="OnCompleteAll" Margin="0,0,8,0"/>
    <Button Style="{StaticResource AccentButton}" x:Name="CompleteSelected" Content="{local:Tr challenge.complete_selected}" IsEnabled="False" Click="OnCompleteSelected" ToolTip="{local:Tr challenge.select_checkpoint}"/>
   </WrapPanel>
   <TextBlock x:Name="EditNote" Grid.Column="2" Grid.Row="3" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
  </Grid>
 </Grid>
</UserControl>
