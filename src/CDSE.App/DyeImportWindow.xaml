<Window x:Class="CDSE.App.DyeImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CDSE.App"
 Style="{StaticResource DialogWindow}" Title="{local:Tr dye.import}" Width="1100" Height="640" MinWidth="720" MinHeight="450" WindowStartupLocation="CenterOwner">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{local:Tr dye.import_prompt}" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <DataGrid x:Name="Rows" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" PreviewKeyDown="OnKey">
   <DataGrid.Columns>
    <DataGridTemplateColumn Width="46" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Possible}" Click="OnCheck" Focusable="False" HorizontalAlignment="Center" AutomationProperties.Name="{Binding Name}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn x:Name="PictureColumn" Width="Auto" MinWidth="40" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding Icon}" Width="32" Height="32"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="{local:Tr 'quest.col_name'}" Binding="{Binding Name}" Width="*" MinWidth="150"/>
    <DataGridTemplateColumn Header="{local:Tr dye.colors}" Width="Auto" MinWidth="130" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <ItemsControl ItemsSource="{Binding Swatches}" Focusable="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate><Border Width="18" Height="18" CornerRadius="3" Margin="0,0,4,0" Background="{Binding}" BorderBrush="{DynamicResource text_dim}" BorderThickness="1"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <!-- Each owned item with where it is, its enhancement and its dye now, or a new one. -->
    <DataGridTemplateColumn Header="{local:Tr dye.target}" Width="1.6*" MinWidth="240" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Choice, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding Possible, Converter={StaticResource BooleanVisibility}}" IsEnabled="{Binding IsChecked}" AutomationProperties.Name="{local:Tr dye.target}">
      <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal">
       <TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
       <TextBlock Text="{Binding Enchant}" Foreground="{DynamicResource success}" Margin="6,0,0,0" VerticalAlignment="Center"/>
       <ItemsControl ItemsSource="{Binding Swatches}" Focusable="False" Margin="8,0,0,0" VerticalAlignment="Center"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate><Border Width="12" Height="12" CornerRadius="2" Margin="0,0,3,0" Background="{Binding}" BorderBrush="{DynamicResource text_dim}" BorderThickness="1"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></DataTemplate></ComboBox.ItemTemplate>
     </ComboBox>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="{local:Tr dye.result}" Binding="{Binding Result}" Width="*" MinWidth="150">
     <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsChecked}" Value="False"><Setter Property="Foreground" Value="{DynamicResource text_dim}"/></DataTrigger><DataTrigger Binding="{Binding Possible}" Value="False"><Setter Property="Foreground" Value="{DynamicResource error}"/></DataTrigger></Style.Triggers></Style></DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
   </DataGrid.Columns>
  </DataGrid>
  <DockPanel Grid.Row="2" Margin="0,12,0,0">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="Accept" Style="{StaticResource AccentButton}" Content="{local:Tr dye.apply}" IsDefault="True" Click="OnAccept"/><Button Content="{local:Tr 'btn.cancel'}" IsCancel="True" Margin="8,0,0,0"/></StackPanel>
   <TextBlock x:Name="Summary" TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" Margin="0,0,12,0"/>
  </DockPanel>
 </Grid>
</Window>
