<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CDSE.App" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
 <!-- Design system (CDSE brand kit, private/assets/brand-kit): Pretendard for every interface text, Rajdhani for the
      logotype only. Colors are the theme keys of ui_themes.json; brand (crimson) marks where you are, accent (ice steel)
      marks what changes the save, error what removes or reverts. Radii: 6 controls, 8 group frames. -->
 <FontFamily x:Key="BodyFont">pack://application:,,,/CDSE;component/fonts/#Pretendard, Yu Gothic UI, Segoe UI</FontFamily>
 <FontFamily x:Key="BrandFont">pack://application:,,,/CDSE;component/fonts/#Rajdhani, Segoe UI</FontFamily>
 <!-- The emblem of cdse-mark.svg (resources/assets) at small sizes: strokes thickened as the brand kit's flat mark advises below 32px. -->
 <LinearGradientBrush x:Key="MarkBrand" MappingMode="Absolute" StartPoint="160,840" EndPoint="840,180"><GradientStop Offset="0" Color="#A61143"/><GradientStop Offset="0.28" Color="#CC1E4B"/><GradientStop Offset="0.56" Color="#E63737"/><GradientStop Offset="0.82" Color="#F65924"/><GradientStop Offset="1" Color="#FF8C1C"/></LinearGradientBrush>
 <LinearGradientBrush x:Key="MarkC" MappingMode="Absolute" StartPoint="160,680" EndPoint="460,320"><GradientStop Offset="0" Color="#A81347"/><GradientStop Offset="0.5" Color="#D42245"/><GradientStop Offset="1" Color="#F04330"/></LinearGradientBrush>
 <LinearGradientBrush x:Key="MarkD" MappingMode="Absolute" StartPoint="560,740" EndPoint="830,280"><GradientStop Offset="0" Color="#D12144"/><GradientStop Offset="0.45" Color="#EF462E"/><GradientStop Offset="1" Color="#FF7F1F"/></LinearGradientBrush>
 <LinearGradientBrush x:Key="MarkBeam" MappingMode="Absolute" StartPoint="520,505" EndPoint="880,140"><GradientStop Offset="0" Color="#F5FF6250"/><GradientStop Offset="0.52" Color="#D1FF7824"/><GradientStop Offset="1" Color="#00FF9A2E"/></LinearGradientBrush>
 <RadialGradientBrush x:Key="MarkHalo"><GradientStop Offset="0" Color="#FF5A4E"/><GradientStop Offset="1" Color="#CC1E44"/></RadialGradientBrush>
 <CombinedGeometry x:Key="MarkSlash" GeometryCombineMode="Exclude"><CombinedGeometry.Geometry1><RectangleGeometry Rect="0,0,1024,1024"/></CombinedGeometry.Geometry1>
  <CombinedGeometry.Geometry2><GeometryGroup><PathGeometry Figures="M520,498 L852,118 892,152 544,504Z"/><PathGeometry Figures="M534,512 L894,254 912,286 550,522Z"/></GeometryGroup></CombinedGeometry.Geometry2></CombinedGeometry>
 <DrawingImage x:Key="BrandMark"><DrawingImage.Drawing><DrawingGroup>
  <GeometryDrawing Geometry="M262,426 L262,154 424,316 M262,154 L352,332 M420,316 L592,316 M366,716 L512,868 664,708 M438,588 L438,792 M586,588 L586,792 M512,548 L512,708 M512,794 L512,864"><GeometryDrawing.Pen><Pen Brush="{StaticResource MarkBrand}" Thickness="20" LineJoin="Miter"/></GeometryDrawing.Pen></GeometryDrawing>
  <DrawingGroup ClipGeometry="{StaticResource MarkSlash}">
   <GeometryDrawing Geometry="M588,316 L752,154 752,260 M752,154 L662,336 M754,360 L856,184 856,306 762,366 M856,184 L784,348"><GeometryDrawing.Pen><Pen Brush="{StaticResource MarkBrand}" Thickness="19" LineJoin="Miter"/></GeometryDrawing.Pen></GeometryDrawing>
   <GeometryDrawing Brush="{StaticResource MarkD}" Geometry="M586,310 L616,310 C738,310 818,398 818,516 C818,634 738,722 616,722 L586,722 L586,586 L648,534 L648,656 C712,652 754,598 754,516 C754,434 712,378 648,376 L586,376Z"/>
  </DrawingGroup>
  <GeometryDrawing Brush="{StaticResource MarkC}" Geometry="M436,452 L482,406 L414,338 Q372,296 330,338 L150,518 L330,698 Q372,740 414,698 L482,630 L436,584 L382,638 Q372,648 362,638 L242,518 L362,398 Q372,388 382,398Z"/>
  <GeometryDrawing Geometry="M302,454 L424,544"><GeometryDrawing.Pen><Pen Brush="{StaticResource MarkC}" Thickness="15" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen></GeometryDrawing>
  <GeometryDrawing Brush="{StaticResource MarkC}" Geometry="M354,492 C354,532 372,548 408,558 C424,562 434,574 438,594 L438,548 C424,532 390,510 354,492Z"/>
  <GeometryDrawing Geometry="M722,454 L600,544"><GeometryDrawing.Pen><Pen Brush="{StaticResource MarkD}" Thickness="15" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen></GeometryDrawing>
  <GeometryDrawing Brush="{StaticResource MarkD}" Geometry="M670,492 C670,532 652,548 616,558 C600,562 590,574 586,594 L586,548 C600,532 634,510 670,492Z"/>
  <GeometryDrawing Brush="{StaticResource MarkBeam}" Geometry="M528,495 L868,120 870,122 532,499Z M536,512 L894,292 895,295 539,515Z"/>
  <GeometryDrawing Brush="{StaticResource MarkBrand}" Geometry="M512,702 L558,750 512,798 466,750Z"/>
  <GeometryDrawing Brush="{StaticResource MarkHalo}"><GeometryDrawing.Geometry><EllipseGeometry Center="512,515" RadiusX="40" RadiusY="40"/></GeometryDrawing.Geometry></GeometryDrawing>
  <GeometryDrawing Brush="#FFFFFF"><GeometryDrawing.Geometry><EllipseGeometry Center="512,515" RadiusX="19" RadiusY="19"/></GeometryDrawing.Geometry></GeometryDrawing>
 </DrawingGroup></DrawingImage.Drawing></DrawingImage>
 <!-- The gradient rule under the logotype, also drawn under the title bar. -->
 <LinearGradientBrush x:Key="BrandRule" StartPoint="0,0" EndPoint="1,0"><GradientStop Offset="0" Color="#00C81D4E"/><GradientStop Offset="0.18" Color="#EBD42246"/><GradientStop Offset="0.52" Color="#FF6A22"/><GradientStop Offset="0.82" Color="#EBD42246"/><GradientStop Offset="1" Color="#00C81D4E"/></LinearGradientBrush>
 <Style x:Key="BrandName" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource BrandFont}"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{DynamicResource text}"/></Style>
 <Style TargetType="Window"><Setter Property="FontFamily" Value="{StaticResource BodyFont}"/><Setter Property="FontSize" Value="{DynamicResource BodySize}"/><Setter Property="Background" Value="{DynamicResource bg}"/><Setter Property="Foreground" Value="{DynamicResource text}"/><Setter Property="UseLayoutRounding" Value="True"/><Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/><Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/></Style>
 <!-- Ideal, not Display: Pretendard has no TrueType hinting, and Display snaps its unhinted glyphs to pixels, which thinned
      strokes unevenly and dropped thin bars (2026-11-27, compared side by side at 14 and 16 px). -->
 <Style TargetType="UserControl"><Setter Property="FontFamily" Value="{StaticResource BodyFont}"/><Setter Property="FontSize" Value="{DynamicResource BodySize}"/><Setter Property="Foreground" Value="{DynamicResource text}"/></Style>
 <Style TargetType="TextBlock"/>
 <!-- Table status text: rows expose Done for the green state and Dim for the grey one. -->
 <Style x:Key="StatusText" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource warning}"/>
  <Style.Triggers><DataTrigger Binding="{Binding Dim}" Value="True"><Setter Property="Foreground" Value="{DynamicResource text_dim}"/></DataTrigger><DataTrigger Binding="{Binding Done}" Value="True"><Setter Property="Foreground" Value="{DynamicResource success}"/></DataTrigger></Style.Triggers>
 </Style>
 <!-- Missing game images (before sync) leave no blank frame. -->
 <Style TargetType="Image"><Style.Triggers><Trigger Property="Source" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
 <Style x:Key="SecondaryText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource text_dim}"/><Setter Property="FontSize" Value="{DynamicResource SmallSize}"/></Style>
 <!-- What an Abyss Gear in a socket does; hidden while the socket is empty. -->
 <Style x:Key="GearEffectText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="{DynamicResource SmallSize}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
 <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,12,0,8"/></Style>
 <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="{DynamicResource TitleSize}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 <Style TargetType="Label"><Setter Property="Foreground" Value="{DynamicResource text}"/><Setter Property="Padding" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style TargetType="Button">
  <Setter Property="Background" Value="{DynamicResource panel}"/><Setter Property="Foreground" Value="{DynamicResource text}"/><Setter Property="BorderBrush" Value="{DynamicResource border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="{DynamicResource ButtonPadding}"/><Setter Property="MinHeight" Value="34"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"><local:ActionGlyph Kind="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={x:Static local:ActionGlyph.Converter}}" Width="16" Height="16" Margin="0,0,6,0" Foreground="{TemplateBinding Foreground}"/><ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource accent}"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  <!-- Style triggers rather than template ones, so the filled buttons below can keep their fill on hover. -->
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource hover}"/><Setter Property="BorderBrush" Value="{DynamicResource accent}"/></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource accent}"/><Setter Property="Foreground" Value="{DynamicResource accent_text}"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource text_dim}"/><Setter Property="Background" Value="{DynamicResource bg}"/><Setter Property="BorderBrush" Value="{DynamicResource border}"/><Setter Property="Opacity" Value="0.7"/></Trigger>
  </Style.Triggers>
 </Style>
 <!-- Changes the open save: accent outline. -->
 <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="{DynamicResource accent}"/><Setter Property="BorderBrush" Value="{DynamicResource accent}"/></Style>
 <!-- Save, the one brand-filled button. -->
 <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource brand_fill}"/><Setter Property="Foreground" Value="{DynamicResource brand_text}"/><Setter Property="BorderBrush" Value="{DynamicResource brand}"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource brand_fill}"/><Setter Property="BorderBrush" Value="{DynamicResource brand_text}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource brand}"/><Setter Property="Foreground" Value="{DynamicResource brand_text}"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource text_dim}"/><Setter Property="Background" Value="{DynamicResource bg}"/><Setter Property="BorderBrush" Value="{DynamicResource border}"/><Setter Property="FontWeight" Value="Normal"/></Trigger></Style.Triggers></Style>
 <!-- The bulk action of a count row: accent fill. -->
 <Style x:Key="BulkButton" TargetType="Button" BasedOn="{StaticResource AccentButton}"><Setter Property="Background" Value="{DynamicResource accent}"/><Setter Property="Foreground" Value="{DynamicResource accent_text}"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource accent}"/><Setter Property="BorderBrush" Value="{DynamicResource text}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource text_dim}"/><Setter Property="Background" Value="{DynamicResource bg}"/><Setter Property="BorderBrush" Value="{DynamicResource border}"/><Setter Property="FontWeight" Value="Normal"/></Trigger></Style.Triggers></Style>
 <!-- Removes or reverts: red outline, red when pressed. -->
 <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="{DynamicResource error}"/><Setter Property="BorderBrush" Value="{DynamicResource error}"/>
  <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource error}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource error}"/><Setter Property="Foreground" Value="{DynamicResource bg}"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource text_dim}"/><Setter Property="BorderBrush" Value="{DynamicResource border}"/></Trigger></Style.Triggers></Style>
 <!-- Two related actions of a detail panel, side by side. -->
 <Style x:Key="ButtonPair" TargetType="UniformGrid"><Setter Property="Columns" Value="2"/><Setter Property="Margin" Value="-4,0,-4,8"/></Style>
 <Style x:Key="PairButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="4,0"/><Setter Property="Padding" Value="6"/></Style>
 <Style x:Key="PairAccent" TargetType="Button" BasedOn="{StaticResource AccentButton}"><Setter Property="Margin" Value="4,0"/><Setter Property="Padding" Value="6"/></Style>
 <Style x:Key="PairDanger" TargetType="Button" BasedOn="{StaticResource DangerButton}"><Setter Property="Margin" Value="4,0"/><Setter Property="Padding" Value="6"/></Style>
 <!-- A glyph alone; every such button needs a tooltip and an automation name. -->
 <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="8,6"/><Setter Property="MinWidth" Value="36"/></Style>
 <Style x:Key="IconAccent" TargetType="Button" BasedOn="{StaticResource AccentButton}"><Setter Property="Padding" Value="8,6"/><Setter Property="MinWidth" Value="36"/></Style>
 <!-- The minimize, maximize and close buttons of the title bars. -->
 <Style x:Key="CaptionButton" TargetType="Button"><Setter Property="Width" Value="46"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource text}"/><Setter Property="Focusable" Value="False"/><Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Box" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource hover}"/></Trigger></Style.Triggers></Style>
 <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource error}"/><Setter Property="Foreground" Value="{DynamicResource bg}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></Style.Triggers></Style>
 <!-- Every window but the main one: a title bar of its own with the title and a close button. -->
 <Style x:Key="DialogWindow" TargetType="Window" BasedOn="{StaticResource {x:Type Window}}">
  <Setter Property="WindowChrome.WindowChrome"><Setter.Value><WindowChrome CaptionHeight="30" GlassFrameThickness="0,0,0,1" CornerRadius="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/></Setter.Value></Setter>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Window">
   <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource border}" BorderThickness="1"><DockPanel>
    <DockPanel DockPanel.Dock="Top" Height="36" Background="{DynamicResource header}" LayoutTransform="{DynamicResource UiTransform}">
     <Button DockPanel.Dock="Right" Style="{StaticResource CloseCaptionButton}" Command="{x:Static SystemCommands.CloseWindowCommand}" ToolTip="{local:Tr window.close}" AutomationProperties.Name="{local:Tr window.close}"><local:ActionGlyph Kind="window_close" local:ActionGlyph.Show="True" Width="15" Height="15"/></Button>
     <TextBlock Text="{TemplateBinding Title}" Margin="14,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BrandRule}"/>
    <AdornerDecorator><ContentPresenter/></AdornerDecorator>
   </DockPanel></Border>
   <!-- Windows pushes a maximized window's frame past the screen edges. -->
   <ControlTemplate.Triggers><Trigger Property="WindowState" Value="Maximized"><Setter TargetName="Frame" Property="Padding" Value="8"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource input_bg}"/><Setter Property="Foreground" Value="{DynamicResource text}"/><Setter Property="CaretBrush" Value="{DynamicResource text}"/><Setter Property="SelectionBrush" Value="{DynamicResource selected}"/><Setter Property="BorderBrush" Value="{DynamicResource border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="{DynamicResource InputPadding}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><Grid><TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}" Foreground="{DynamicResource text_dim}" IsHitTestVisible="False" Visibility="Collapsed"/><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource text_dim}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource text_dim}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ComboBox"><Setter Property="Background" Value="{DynamicResource input_bg}"/><Setter Property="Foreground" Value="{DynamicResource text}"/><Setter Property="BorderBrush" Value="{DynamicResource border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="{DynamicResource InputPadding}"/><Setter Property="MinHeight" Value="34"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Box" Background="{DynamicResource input_bg}" BorderBrush="{DynamicResource border}" BorderThickness="1" CornerRadius="6"><Path Data="M0,0 L5,5 10,0" Stroke="{DynamicResource text_dim}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,8"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource text_dim}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" Margin="8,5,30,5" VerticalAlignment="Center" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource panel}" BorderBrush="{DynamicResource border}" BorderThickness="1" CornerRadius="6" Padding="0,4" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource text_dim}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource text}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="10,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Box" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Margin="4,0" CornerRadius="4"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource accent}"/></Trigger><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource selected}"/><Setter Property="Foreground" Value="{DynamicResource selection_text}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource text}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="18" Height="18" Margin="0,0,8,0" CornerRadius="4" BorderBrush="{DynamicResource text_dim}" BorderThickness="1.5" Background="{DynamicResource input_bg}"><Path x:Name="Mark" Data="M3,8 L6.5,11.5 13,4" Stroke="{DynamicResource accent_text}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/></Border><ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource accent}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Visibility" Value="Visible"/><Setter TargetName="Box" Property="Background" Value="{DynamicResource accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource accent}"/></Trigger><Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="Mark" Property="Visibility" Value="Visible"/><Setter TargetName="Mark" Property="Data" Value="M4,8 L12,8"/><Setter TargetName="Mark" Property="Stroke" Value="{DynamicResource accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource text}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="18" Height="18" Margin="0,0,8,0" CornerRadius="9" BorderBrush="{DynamicResource text_dim}" BorderThickness="1.5" Background="{DynamicResource input_bg}"><Ellipse x:Name="Mark" Width="8" Height="8" Fill="{DynamicResource accent}" Visibility="Collapsed"/></Border><ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource accent}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Visibility" Value="Visible"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="TabControl"><Setter Property="Background" Value="{DynamicResource bg}"/><Setter Property="Foreground" Value="{DynamicResource text}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><DockPanel><ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" IsItemsHost="True"/></ScrollViewer><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></DockPanel></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource text_dim}"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Box" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource text}"/><Setter TargetName="Box" Property="Background" Value="{DynamicResource hover}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource hover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource text}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource brand}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="DataGrid"><Setter Property="local:Appearance.RowNumbers" Value="True"/><Setter Property="Background" Value="{DynamicResource panel}"/><Setter Property="Foreground" Value="{DynamicResource text}"/><Setter Property="BorderBrush" Value="{DynamicResource border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource header}"/><Setter Property="VerticalGridLinesBrush" Value="{DynamicResource header}"/><Setter Property="GridLinesVisibility" Value="All"/><Setter Property="RowBackground" Value="{DynamicResource panel}"/><Setter Property="RowHeight" Value="{DynamicResource TableRowHeight}"/><Setter Property="HeadersVisibility" Value="All"/><Setter Property="RowHeaderWidth" Value="32"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/></Style>
 <Style TargetType="DataGridRow"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource hover}"/></Trigger></Style.Triggers></Style>
 <!-- The focus frame is drawn over the cell: one around it would take width from the text and cut it off. -->
 <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource text}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="6,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Grid><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border><Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" IsHitTestVisible="False"/></Grid></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource selected}"/><Setter Property="Foreground" Value="{DynamicResource selection_text}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource accent}"/><Setter Property="BorderThickness" Value="1"/></Trigger></Style.Triggers></Style>
 <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource header}"/><Setter Property="Foreground" Value="{DynamicResource text_dim}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Padding" Value="8,5"/><Setter Property="BorderBrush" Value="{DynamicResource border}"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
  <!-- The header chrome skips its own sort arrow once a background is set, so the content carries it. -->
  <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><StackPanel Orientation="Horizontal"><ContentPresenter Content="{Binding}" VerticalAlignment="Center"/><Path x:Name="Arrow" Width="8" Height="5" Margin="5,0,0,0" Stretch="Fill" VerticalAlignment="Center" Fill="{DynamicResource accent}" Visibility="Collapsed" Data="M0,5 L4,0 L8,5 Z"/></StackPanel>
   <DataTemplate.Triggers><DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Value="Ascending"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Value="Descending"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/><Setter TargetName="Arrow" Property="Data" Value="M0,0 L8,0 L4,5 Z"/></DataTrigger></DataTemplate.Triggers></DataTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="DataGridRowHeader"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridRowHeader"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Setter Property="Background" Value="{DynamicResource header}"/><Setter Property="Foreground" Value="{DynamicResource text_dim}"/><Setter Property="BorderBrush" Value="{DynamicResource border}"/><Setter Property="BorderThickness" Value="0,0,1,1"/></Style>
 <Style TargetType="ListBox"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter><Setter Property="Background" Value="{DynamicResource panel}"/><Setter Property="Foreground" Value="{DynamicResource text}"/><Setter Property="BorderBrush" Value="{DynamicResource border}"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/></Style>
 <!-- List rows show the accent frame only while the keyboard moves through them (a focus visual), not after a click. -->
 <Style x:Key="RowFocus"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Border BorderBrush="{DynamicResource accent}" BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True"/></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ListBoxItem"><Setter Property="FocusVisualStyle" Value="{StaticResource RowFocus}"/><Setter Property="Foreground" Value="{DynamicResource text}"/><Setter Property="Padding" Value="8,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Box" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource hover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource selected}"/><Setter Property="Foreground" Value="{DynamicResource selection_text}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="local:ActionGlyph"><Style.Triggers><Trigger Property="Kind" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="local:ActionGlyph.Show" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
 <!-- The main navigation: a crimson bar marks the open section. -->
 <Style x:Key="NavigationItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="MinHeight" Value="48"/><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="12,6"/><Setter Property="Foreground" Value="{DynamicResource text_dim}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Grid><Border x:Name="Box" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border><Border x:Name="Bar" Width="3" Margin="0,10" CornerRadius="2" HorizontalAlignment="Left" Background="{DynamicResource brand}" Visibility="Hidden"/></Grid>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource hover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource selected}"/><Setter TargetName="Bar" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource selection_text}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers></Style>
 <Style TargetType="TreeView"><Setter Property="Background" Value="{DynamicResource panel}"/><Setter Property="Foreground" Value="{DynamicResource text}"/><Setter Property="BorderBrush" Value="{DynamicResource border}"/></Style>
 <Style TargetType="TreeViewItem"><Setter Property="Foreground" Value="{DynamicResource text}"/><Setter Property="Padding" Value="4,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
 <Style TargetType="GroupBox"><Setter Property="Foreground" Value="{DynamicResource text}"/><Setter Property="BorderBrush" Value="{DynamicResource border}"/><Setter Property="Margin" Value="0,8,0,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupBox"><Grid><Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,10,0,0" Background="{TemplateBinding Background}"/><StackPanel><Border Background="{DynamicResource bg}" Padding="5,0" HorizontalAlignment="Left" Margin="10,0,0,0"><ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold"/></Border><ContentPresenter Margin="{TemplateBinding Padding}"/></StackPanel></Grid></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ScrollViewer"><Setter Property="PanningMode" Value="Both"/></Style>
 <Style TargetType="GridSplitter"><Setter Property="Background" Value="{DynamicResource bg}"/></Style>
 <Style TargetType="ToolTip"><Setter Property="Background" Value="{DynamicResource header}"/><Setter Property="Foreground" Value="{DynamicResource text}"/><Setter Property="BorderBrush" Value="{DynamicResource border}"/><Setter Property="FontFamily" Value="{StaticResource BodyFont}"/><Setter Property="FontSize" Value="{DynamicResource SmallSize}"/><Setter Property="Padding" Value="10,6"/><Setter Property="HasDropShadow" Value="False"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}" MaxWidth="480"><ContentPresenter><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources></ContentPresenter></Border></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="Menu"><Setter Property="FontFamily" Value="{StaticResource BodyFont}"/><Setter Property="FontSize" Value="{DynamicResource BodySize}"/><Setter Property="Background" Value="{DynamicResource header}"/><Setter Property="Foreground" Value="{DynamicResource primary_text}"/></Style>
 <!-- The system template paints a light column for icons, which no menu here has. -->
 <Style TargetType="ContextMenu"><Setter Property="FontFamily" Value="{StaticResource BodyFont}"/><Setter Property="FontSize" Value="{DynamicResource BodySize}"/><Setter Property="Background" Value="{DynamicResource panel}"/><Setter Property="Foreground" Value="{DynamicResource text}"/><Setter Property="BorderBrush" Value="{DynamicResource border}"/><Setter Property="HasDropShadow" Value="False"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="0,4" MinWidth="120"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></Border></ControlTemplate></Setter.Value></Setter></Style>
 <!-- The system MenuItem template paints submenu popups light grey; this one uses the theme colors. No nested submenus or check marks are used. -->
 <Style TargetType="MenuItem"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource text}"/><Setter Property="Padding" Value="12,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
  <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="4,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
    <TextBlock x:Name="Gesture" Grid.Column="1" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource text_dim}" Margin="32,0,0,0" VerticalAlignment="Center"/>
    <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
     <Border Background="{DynamicResource panel}" BorderBrush="{DynamicResource border}" BorderThickness="1" CornerRadius="8" Padding="0,4" MinWidth="200"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></Border>
    </Popup>
   </Grid>
  </Border>
  <ControlTemplate.Triggers>
   <Trigger Property="Role" Value="TopLevelHeader"><Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/><Setter Property="Padding" Value="10,4"/><Setter TargetName="Bd" Property="Margin" Value="0,4"/></Trigger>
   <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource hover}"/></Trigger>
   <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource hover}"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter></Style>
 <!-- A group label inside a menu (the dye page's wear-set menu: each character, then its actions); not a command. -->
 <Style x:Key="MenuGroup" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"><Setter Property="Focusable" Value="False"/><Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Foreground" Value="{DynamicResource text_dim}"/><Setter Property="FontSize" Value="{DynamicResource SmallSize}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,6,12,2"/></Style>
 <Style TargetType="Separator"><Setter Property="Background" Value="{DynamicResource border}"/></Style>
 <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Margin="8,4" Background="{DynamicResource border}"/></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ProgressBar"><Setter Property="Foreground" Value="{DynamicResource brand_fill}"/><Setter Property="Background" Value="{DynamicResource input_bg}"/><Setter Property="BorderBrush" Value="{DynamicResource border}"/><Setter Property="Height" Value="18"/></Style>

 <Style TargetType="ScrollBar"><Setter Property="Width" Value="12"/><Setter Property="Background" Value="{DynamicResource bg}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton x:Name="PageBefore" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="{DynamicResource border}" CornerRadius="4" MinHeight="8" MinWidth="8" Margin="2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource text_dim}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource text_dim}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton x:Name="PageAfter" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="PageBefore" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="PageAfter" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/></Trigger></Style.Triggers></Style>
 <Style TargetType="RepeatButton"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource hover}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Setter Property="Background" Value="{DynamicResource input_bg}"/><Setter Property="Foreground" Value="{DynamicResource text_dim}"/><Setter Property="BorderBrush" Value="{DynamicResource border}"/></Style>
 <!-- Tree rows of the two-table pages (challenges, knowledge): an arrow and a full-width header, so count and status columns line up.
      The node exposes Expanded and Selected. The default TreeViewItem keeps headers at text width. -->
 <Style x:Key="TreeExpander" TargetType="ToggleButton">
  <Setter Property="Focusable" Value="False"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
   <Border Background="Transparent" Width="19">
    <Path x:Name="Arrow" Data="M 0,0 L 5,4 L 0,8 Z" Fill="{DynamicResource text_dim}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform/></Path.RenderTransform></Path>
   </Border>
   <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="TableTreeItem" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
  <Setter Property="IsExpanded" Value="{Binding Expanded, Mode=TwoWay}"/><Setter Property="IsSelected" Value="{Binding Selected, Mode=TwoWay}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem">
   <StackPanel>
    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
     <DockPanel><ToggleButton x:Name="Expander" Style="{StaticResource TreeExpander}" ClickMode="Press" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/><ContentPresenter ContentSource="Header"/></DockPanel>
    </Border>
    <ItemsPresenter x:Name="Items" Margin="19,0,0,0"/>
   </StackPanel>
   <ControlTemplate.Triggers>
    <Trigger Property="IsExpanded" Value="False"><Setter TargetName="Items" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource selected}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- Filter row and count row shared by every list page (the item editor is the reference). -->
 <Style x:Key="FilterLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,12,0"/></Style>
 <Style x:Key="FilterBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Width" Value="200"/><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style x:Key="CountRow" TargetType="DockPanel"><Setter Property="Margin" Value="0,12,0,12"/><Setter Property="LastChildFill" Value="True"/></Style>
 <Style x:Key="CountText" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
</ResourceDictionary>
