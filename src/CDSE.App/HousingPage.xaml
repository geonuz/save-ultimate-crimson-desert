<UserControl x:Class="CDSE.App.HousingPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CDSE.App">
 <Grid IsEnabled="{Binding CanEditSelection}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <local:PageHeader HelpTopic="housing.title" LoadedState="{Binding Housing, Converter={x:Static local:PresentConverter.Shared}}"><local:PageHeader.LoadButton><Button x:Name="LoadData" DockPanel.Dock="Right" Content="{local:Tr ui.load_data}" Command="{Binding LoadHousingCommand}"/></local:PageHeader.LoadButton></local:PageHeader>
  <DockPanel Grid.Row="1" Style="{StaticResource CountRow}">
   <Button Style="{StaticResource BulkButton}" x:Name="ActivateAll" DockPanel.Dock="Right" Content="{local:Tr housing.activate_all}" Click="OnActivateAll" IsEnabled="False"/>
   <TextBlock x:Name="Count" Text="{local:Tr ui.load_prompt}" Style="{StaticResource CountText}"/>
  </DockPanel>
  <local:DetailSplit Grid.Row="2">
   <DataGrid x:Name="Rows" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="OnSelectionChanged">
    <DataGrid.Columns>
     <DataGridTextColumn Header="{local:Tr housing.name}" Binding="{Binding Name}" Width="*" MinWidth="180"/>
     <DataGridTextColumn Header="{local:Tr housing.key}" Binding="{Binding Key}" Width="Auto" MinWidth="80"/>
     <DataGridTextColumn Header="{local:Tr housing.region}" Binding="{Binding Region}" Width="Auto" MinWidth="90"/>
     <DataGridTextColumn Header="{local:Tr housing.state}" Binding="{Binding State}" SortMemberPath="Done" Width="Auto" MinWidth="70" ElementStyle="{StaticResource StatusText}"/>
     <DataGridTextColumn Header="{local:Tr housing.house_kind}" Binding="{Binding Kind}" Width="Auto" MinWidth="80"/>
     <DataGridTextColumn Header="{local:Tr housing.structures}" Binding="{Binding Structures, StringFormat=N0}" Width="Auto" MinWidth="70"/>
     <DataGridTextColumn Header="{local:Tr housing.furnishings}" Binding="{Binding Furnishings, StringFormat=N0}" Width="Auto" MinWidth="70"/>
    </DataGrid.Columns>
   </DataGrid>
   <ScrollViewer x:Name="Details" Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="12,0,0,0">
    <StackPanel>
     <TextBlock x:Name="SelectedTitle" Text="{local:Tr ui.select_item}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <TextBlock x:Name="Summary" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>
     <Button Style="{StaticResource AccentButton}" x:Name="ActivateSelected" Content="{local:Tr housing.activate}" Click="OnActivateSelected" IsEnabled="False" Margin="0,0,0,6"/>
     <UniformGrid Style="{StaticResource ButtonPair}" Margin="-4,0,-4,6">
      <Button Style="{StaticResource PairButton}" x:Name="Export" Content="{local:Tr housing.export}" Click="OnExport" IsEnabled="False"/>
      <Button Style="{StaticResource PairAccent}" x:Name="Import" Content="{local:Tr housing.import}" Click="OnImport" IsEnabled="False"/>
     </UniformGrid>
     <Button Style="{StaticResource AccentButton}" x:Name="Rotate" Content="{local:Tr housing.rotate}" Click="OnRotate" IsEnabled="False" ToolTip="{local:Tr housing.rotate_hint}" ToolTipService.ShowOnDisabled="True" Margin="0,0,0,6"/>
     <!-- Why the plot cannot take a house, in the same red as a read-only state. -->
     <TextBlock x:Name="Hint" TextWrapping="Wrap" Margin="0,8" Visibility="Collapsed" Foreground="{DynamicResource error}"/>
    </StackPanel>
   </ScrollViewer>
  </local:DetailSplit>
 </Grid>
</UserControl>
