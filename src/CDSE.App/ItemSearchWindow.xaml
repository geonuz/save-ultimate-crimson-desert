<Window x:Class="CDSE.App.ItemSearchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:CDSE.App" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource DialogWindow}" Title="{local:Tr 'Swap Sold Item'}" Width="650" Height="500" MinWidth="600" MinHeight="450" WindowStartupLocation="CenterOwner">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="Hint" Text="{local:Tr swap.search_hint}" TextWrapping="Wrap" Margin="0,0,0,10"/>
  <DockPanel Grid.Row="1" Margin="0,0,0,10">
   <TextBox x:Name="SearchBox" TextChanged="OnFilter" AutomationProperties.Name="{local:Tr 'Search item name or key'}"/>
  </DockPanel>
  <DataGrid x:Name="Results" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="OnSelection" MouseDoubleClick="OnDoubleClick">
   <DataGrid.Columns>
    <DataGridTemplateColumn x:Name="PictureColumn" Width="Auto" MinWidth="40" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding Icon}" Width="{Binding PictureSize, RelativeSource={RelativeSource AncestorType=local:ItemSearchWindow}}" Height="{Binding PictureSize, RelativeSource={RelativeSource AncestorType=local:ItemSearchWindow}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn x:Name="KeyColumn" Header="{local:Tr 'quest.col_key'}" Binding="{Binding Key}" Width="115"/><DataGridTextColumn Header="{local:Tr 'quest.col_name'}" Binding="{Binding Name}" Width="*"/><DataGridTextColumn x:Name="CategoryColumn" Header="{local:Tr 'fishing.category'}" Binding="{Binding Category}" Width="150"/>
    <DataGridTemplateColumn x:Name="EffectColumn" Header="{local:Tr 'socket.effect'}" Width="2.4*" Visibility="Collapsed" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Effect}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Detail}" ToolTipService.ShowDuration="60000"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   </DataGrid.Columns>
  </DataGrid>
  <DockPanel Grid.Row="3" Margin="0,10,0,10"><StackPanel x:Name="Paging" DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="Previous" Content="{local:Tr 'Previous'}" Click="OnPrevious"/><Button x:Name="Next" Content="{local:Tr 'Next'}" Click="OnNext" Margin="8,0,0,0"/></StackPanel><TextBlock x:Name="Count" VerticalAlignment="Center"/></DockPanel>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Accept" Content="{local:Tr 'Select'}" IsDefault="True" IsEnabled="False" Click="OnAccept"/><Button Content="{local:Tr 'btn.cancel'}" IsCancel="True" Margin="8,0,0,0"/></StackPanel>
 </Grid>
</Window>
