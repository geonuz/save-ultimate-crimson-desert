<UserControl x:Class="SaveUltimate.App.MapPlacesPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SaveUltimate.App">
 <Grid IsEnabled="{Binding CanEditSelection}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <local:PageHeader HelpTopic="map.group_places" LoadedState="{Binding Map, Converter={x:Static local:PresentConverter.Shared}}"><local:PageHeader.LoadButton><Button x:Name="LoadData" Content="{local:Tr ui.load_data}" Command="{Binding LoadMapCommand}"/></local:PageHeader.LoadButton>
   <TextBlock Text="{local:Tr 'filter.state'}" Style="{StaticResource FilterLabel}"/>
   <ComboBox x:Name="StateFilter" Style="{StaticResource FilterBox}" SelectedIndex="0" SelectionChanged="OnFilterChanged" AutomationProperties.Name="{local:Tr 'filter.state'}">
    <ComboBoxItem Content="{local:Tr 'All'}"/><ComboBoxItem Content="{local:Tr 'map.state_active'}"/><ComboBoxItem Content="{local:Tr 'map.state_inactive'}"/>
   </ComboBox>
   <Label Content="{local:Tr 'Search:'}" Target="{Binding ElementName=Search}" Margin="0,0,12,0"/>
   <TextBox x:Name="Search" Tag="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" TextChanged="OnSearchChanged" ToolTip="{local:Tr map.search_places}" AutomationProperties.Name="{local:Tr map.search_places}"/>
  </local:PageHeader>
  <DockPanel Grid.Row="1" Style="{StaticResource CountRow}"><TextBlock x:Name="Count" Text="{local:Tr map.load_prompt}" Style="{StaticResource CountText}"/></DockPanel>
  <!-- Each table has its title above and its action below, in shared rows, so both tables start and end at the same height. -->
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="440*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="850*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="{local:Tr 'Category'}" FontWeight="Bold" Margin="0,0,0,8"/>
   <DataGrid x:Name="Categories" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="OnCategoriesSelected">
    <DataGrid.Columns>
     <DataGridTextColumn Header="{local:Tr 'Name'}" Binding="{Binding Name}" Width="*" MinWidth="120"/>
     <DataGridTextColumn Header="{local:Tr map.progress}" Binding="{Binding Progress}" SortMemberPath="Active" Width="Auto"/>
     <DataGridTextColumn Header="{local:Tr 'filter.state'}" Binding="{Binding State}" SortMemberPath="Active" Width="Auto" ElementStyle="{StaticResource StatusText}"/>
    </DataGrid.Columns>
   </DataGrid>
   <Button Style="{StaticResource BulkButton}" x:Name="ActivateCategories" Grid.Row="2" Content="{local:Tr map.activate_categories}" Click="OnActivateCategories" IsEnabled="False" Margin="0,8,0,0"/>
   <GridSplitter Grid.Column="1" Grid.RowSpan="3" Width="6" HorizontalAlignment="Center" ResizeBehavior="PreviousAndNext"/>
   <TextBlock x:Name="Title" Grid.Column="2" Text="{local:Tr map.select_category}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <DataGrid x:Name="Rows" Grid.Column="2" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="OnRowsSelected"
    EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
    <DataGrid.Columns>
     <DataGridTextColumn Header="{local:Tr 'Name'}" Binding="{Binding Name}" Width="*" MinWidth="160"/>
     <DataGridTextColumn Header="{local:Tr 'Internal Name'}" Binding="{Binding InternalName}" Width="*" MinWidth="120"/>
     <DataGridTextColumn Header="{local:Tr 'filter.state'}" Binding="{Binding State}" SortMemberPath="Done" Width="Auto" MinWidth="90" ElementStyle="{StaticResource StatusText}"/>
    </DataGrid.Columns>
   </DataGrid>
   <Button Style="{StaticResource AccentButton}" x:Name="ActivateSelected" Grid.Column="2" Grid.Row="2" Content="{local:Tr map.activate_places}" Click="OnActivateSelected" IsEnabled="False" Margin="0,8,0,0"/>
  </Grid>
 </Grid>
</UserControl>
