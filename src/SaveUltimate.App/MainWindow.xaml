<Window x:Class="SaveUltimate.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SaveUltimate.App"
 Title="SaveUltimate" Icon="app_icon.ico" Width="1400" Height="800" MinWidth="920" MinHeight="640" Style="{StaticResource {x:Type Window}}">
 <Window.InputBindings>
  <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}"/>
  <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
  <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}"/>
  <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
 </Window.InputBindings>
 <DockPanel x:Name="AppShell" LayoutTransform="{DynamicResource UiTransform}">
 <Menu DockPanel.Dock="Top">
  <MenuItem Header="{local:Tr File}">
   <MenuItem Header="{local:Tr ui.slots}" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"/>
   <Separator/><MenuItem Header="{local:Tr Save}" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
   <MenuItem Header="{local:Tr 'Save As...'}" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S"/>
   <MenuItem Header="{local:Tr Settings}" Click="OnSettings"/><Separator/><MenuItem Header="{local:Tr Exit}" Click="OnExit" InputGestureText="Alt+F4"/>
  </MenuItem>
  <MenuItem x:Name="ViewMenu" Header="{local:Tr View}"><MenuItem Header="{local:Tr ui.theme}" Click="OnThemeSettings"/><Separator/></MenuItem>
 </Menu>
 <Border DockPanel.Dock="Bottom" Background="{DynamicResource header}" BorderBrush="{DynamicResource border}" BorderThickness="0,1,0,0"><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" AutomationProperties.LiveSetting="Polite"/></Border>
 <Border x:Name="HelpPanel" DockPanel.Dock="Right" Width="340" Background="{DynamicResource panel}" BorderBrush="{DynamicResource border}" BorderThickness="1,0,0,0" Visibility="Collapsed">
  <DockPanel><DockPanel DockPanel.Dock="Top" Background="{DynamicResource header}"><Button Content="×" Click="OnCloseHelp" DockPanel.Dock="Right" Padding="8,0" AutomationProperties.Name="{local:Tr 'Close help'}"/><TextBlock x:Name="HelpTitle" Margin="12"/></DockPanel><ScrollViewer x:Name="HelpScroll" VerticalScrollBarVisibility="Auto"/></DockPanel>
 </Border>
 <DockPanel x:Name="Shell" SizeChanged="OnShellSizeChanged">
 <Border x:Name="NavigationRail" DockPanel.Dock="Left" Width="212" Background="{DynamicResource panel}" BorderBrush="{DynamicResource border}" BorderThickness="0,0,1,0" Padding="12,20,12,16">
  <DockPanel>
   <StackPanel DockPanel.Dock="Bottom">
    <Button x:Name="SettingsButton" Content="{local:Tr Settings}" Click="OnSettings" Margin="0,0,0,12"/>
    <StackPanel x:Name="VersionText" Orientation="Horizontal">
     <TextBlock x:Name="AppVersion" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
     <Border Margin="8,0,0,0" Padding="7,1,7,2" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource border}" Background="{DynamicResource header}" VerticalAlignment="Center">
      <TextBlock x:Name="GameVersion" FontSize="11" Foreground="{DynamicResource text_dim}"/>
     </Border>
    </StackPanel>
   </StackPanel>
   <DockPanel DockPanel.Dock="Top"><Button x:Name="NavigationToggle" DockPanel.Dock="Right" Content="‹" Click="OnNavigationToggle" Width="32" Padding="0"/><TextBlock x:Name="NavigationBrand" Text="SaveUltimate" Foreground="{DynamicResource accent}" FontSize="{DynamicResource BrandSize}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
   <TextBlock x:Name="NavigationSubtitle" DockPanel.Dock="Top" Text="CRIMSON DESERT" FontSize="12" Foreground="{DynamicResource text_dim}" Margin="0,12,0,24"/>
   <ListBox x:Name="PrimaryNavigation" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource NavigationItem}" SelectionChanged="OnNavigationChanged" IsEnabled="{Binding CanEditSelection}" AutomationProperties.Name="{local:Tr 'Main navigation'}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBoxItem Tag="0" Content="{local:Tr 'tab.items'}" ToolTip="{local:Tr tab.items}" AutomationProperties.Name="{local:Tr 'tab.items'}" MinHeight="44"/>
    <ListBoxItem Tag="5" Content="{local:Tr 'tab.knowledge_quest'}" ToolTip="{local:Tr tab.knowledge_quest}" MinHeight="44"/>
    <ListBoxItem Tag="4" Content="{local:Tr 'skills.title'}" ToolTip="{local:Tr skills.title}" AutomationProperties.Name="{local:Tr 'skills.title'}" MinHeight="44"/>
    <ListBoxItem Tag="8" Content="{local:Tr 'tab.maps'}" ToolTip="{local:Tr tab.maps}" MinHeight="44"/>
    <ListBoxItem Tag="9" Content="{local:Tr 'tab.mercenary'}" ToolTip="NPC · F5" MinHeight="44"/>
    <ListBoxItem Tag="3" Content="{local:Tr 'tab.backup'}" ToolTip="{local:Tr tab.backup}" AutomationProperties.Name="{local:Tr 'tab.backup'}" MinHeight="44"/>
   </ListBox>
  </DockPanel>
 </Border>
 <Grid x:Name="ContentArea">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource panel}" BorderBrush="{DynamicResource border}" BorderThickness="0,0,0,1" Padding="20,12">
   <StackPanel>
   <DockPanel Margin="0,0,0,8">
    <WrapPanel x:Name="HeaderActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="{local:Tr header.open}" Command="{Binding OpenCommand}" ToolTip="{local:Tr ui.slots}" Margin="0,0,6,4"/>
     <Button x:Name="UndoButton" Content="{local:Tr ui.undo}" Command="{Binding UndoCommand}" ToolTip="Ctrl+Z" Margin="0,0,6,4"/>
     <Button Style="{StaticResource DangerButton}" Content="{local:Tr ui.revert_changes}" Command="{Binding RevertCommand}" Margin="0,0,6,4"/>
     <Button Content="{local:Tr header.save}" ToolTip="Ctrl+S" Command="{Binding SaveCommand}" IsEnabled="{Binding HasUnsavedChanges}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,4"/>
    </WrapPanel>
    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center"><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding LoadedPath}"/>
     <TextBlock Text="{Binding FileState}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}"><Style.Triggers>
      <DataTrigger Binding="{Binding FileTone}" Value="warning"><Setter Property="Foreground" Value="{DynamicResource warning}"/></DataTrigger>
      <DataTrigger Binding="{Binding FileTone}" Value="success"><Setter Property="Foreground" Value="{DynamicResource success}"/></DataTrigger>
     </Style.Triggers></Style></TextBlock.Style></TextBlock>
    </StackPanel>
   </DockPanel>
    <DockPanel>
     <!-- Enabled only once a game installation is detected or set in Settings. -->
     <Button x:Name="SyncButton" DockPanel.Dock="Right" VerticalAlignment="Bottom" Content="{local:Tr 'Sync Items Local'}" Command="{Binding SyncGameDataCommand}"
      ToolTip="{local:Tr ui.game_hint}" ToolTipService.ShowOnDisabled="True" Margin="12,0,0,0"/>
     <StackPanel>
      <TextBlock x:Name="SavePathText" Text="{Binding SaveFolderText}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" ToolTip="{Binding SaveFolderText}"/>
      <TextBlock x:Name="GamePathText" Text="{Binding GameFolderText}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" ToolTip="{Binding GameFolderText}" Margin="0,2,0,0"/>
     </StackPanel>
    </DockPanel>
   </StackPanel>
  </Border>
  <CheckBox x:Name="IconsToggle" Grid.Row="1" Panel.ZIndex="2" Content="{local:Tr 'Show Local Icons'}" Checked="OnIconsChanged" Unchecked="OnIconsChanged" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,20,0" Visibility="{Binding IsItems, Converter={StaticResource BooleanVisibility}}"/>
  <TabControl x:Name="ItemTabs" Grid.Row="1" SelectedIndex="{Binding ItemPageIndex}" Visibility="{Binding IsItems, Converter={StaticResource BooleanVisibility}}" IsEnabled="{Binding CanEditSelection}" Margin="20,0,220,0">
   <TabItem Header="{local:Tr 'tab.inventory'}"/><TabItem Header="{local:Tr 'tab.repurchase'}"/><TabItem Header="{local:Tr 'tab.equipment'}"/>
   <TabItem Header="{local:Tr tab.database}"/>
  </TabControl>
  <TabControl x:Name="JournalTabs" SelectedIndex="{Binding JournalPageIndex}" Grid.Row="1" Visibility="{Binding IsJournal, Converter={StaticResource BooleanVisibility}}" IsEnabled="{Binding CanEditSelection}" Margin="20,0,0,0">
   <TabItem Header="{local:Tr 'tab.knowledge'}"/><TabItem Header="{local:Tr 'Challenges'}"/>
   <TabItem Header="{local:Tr 'tab.fishing'}"/>
  </TabControl>
  <local:KnowledgePage x:Name="KnowledgeArea" Grid.Row="3" Visibility="{Binding IsKnowledge, Converter={StaticResource BooleanVisibility}}"/>
  <local:ChallengePage x:Name="ChallengeArea" Grid.Row="3" Visibility="{Binding IsChallenges, Converter={StaticResource BooleanVisibility}}"/>
  <local:FishingPage x:Name="FishingArea" Grid.Row="3" Visibility="{Binding IsFishing, Converter={StaticResource BooleanVisibility}}"/>
  <TabControl x:Name="NpcTabs" SelectedIndex="{Binding NpcPageIndex}" Grid.Row="1" Visibility="{Binding IsNpc, Converter={StaticResource BooleanVisibility}}" IsEnabled="{Binding CanEditSelection}" Margin="20,0,0,0">
   <TabItem Header="{local:Tr companion.title}"/><TabItem Header="{local:Tr npc.title}"/>
  </TabControl>
  <local:MapPage x:Name="MapArea" Grid.Row="3" Visibility="{Binding IsMap, Converter={StaticResource BooleanVisibility}}"/>
  <local:NpcPage x:Name="NpcArea" Grid.Row="3" Visibility="{Binding IsFriendship, Converter={StaticResource BooleanVisibility}}"/>
  <local:CompanionPage x:Name="CompanionArea" Grid.Row="3" Visibility="{Binding IsCompanions, Converter={StaticResource BooleanVisibility}}"/>
  <local:ItemDatabasePage x:Name="DatabaseArea" Grid.Row="3" Visibility="{Binding IsDatabase, Converter={StaticResource BooleanVisibility}}"/>
  <local:SkillsView x:Name="SkillsArea" Grid.Row="3" Visibility="{Binding IsSkills, Converter={StaticResource BooleanVisibility}}"/>
  <StackPanel Grid.Row="2" Visibility="{Binding IsItemEditor, Converter={StaticResource BooleanVisibility}}" Margin="20,8,20,12">
   <local:PageHeader Title="{Binding ItemPageTitle}" LoadCommand="{Binding ReloadCommand}" LoadedState="{Binding HasDocument}" HelpTopic="{Binding ItemHelpTopic}" Margin="0,0,0,12"/>
   <DockPanel>
   <TextBlock Text="{local:Tr 'ui.storage'}" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="{Binding IsInventory, Converter={StaticResource BooleanVisibility}}"/>
   <ComboBox Visibility="{Binding IsInventory, Converter={StaticResource BooleanVisibility}}" ItemsSource="{Binding StorageFilters}" SelectedItem="{Binding Storage}" DisplayMemberPath="Label" Width="200" Margin="0,0,12,0" VerticalContentAlignment="Center" AutomationProperties.Name="{local:Tr 'Storage filter'}"/>
   <Label Content="{local:Tr 'Search:'}" Target="{Binding ElementName=SearchBox}" VerticalAlignment="Center" Padding="0,0,12,0"/>
   <TextBox x:Name="SearchBox" Tag="{local:Tr 'Filter by name, internal name, key, or category...'}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{local:Tr 'Search items, IDs or storage'}" ToolTip="{local:Tr 'Search by item name, ID or storage'}"/>
   </DockPanel><TextBlock Text="{Binding CountText}" Style="{StaticResource SecondaryText}" Margin="0,12,0,0"/>
  </StackPanel>
  <Grid Margin="20,0,20,16" x:Name="ItemArea" Visibility="{Binding IsItemEditor, Converter={StaticResource BooleanVisibility}}" Grid.Row="3" SizeChanged="OnItemAreaSizeChanged">
   <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="0"/><RowDefinition Height="0"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="330" MinWidth="220"/></Grid.ColumnDefinitions>
   <DataGrid x:Name="InventoryGrid" ItemsSource="{Binding ItemsView}" SelectedItem="{Binding Selected}"
    AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnItemDoubleClick" IsEnabled="{Binding CanEditSelection}"
    EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
    CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" HeadersVisibility="All"
    GridLinesVisibility="All" AutomationProperties.Name="{local:Tr 'Inventory items'}">
    <DataGrid.Columns>
     <DataGridTemplateColumn Header="" Width="38" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding Icon}" Width="30" Height="30"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="{local:Tr 'quest.col_name'}" Binding="{Binding Name}" Width="*" MinWidth="180"/>
     <DataGridTextColumn Header="{local:Tr 'ItemNo'}" Binding="{Binding Item.Number}" Width="90"/>
     <DataGridTextColumn Header="{local:Tr 'ItemKey'}" Binding="{Binding Item.Key}" Width="90"/>
     <DataGridTextColumn Header="{local:Tr 'fishing.category'}" Binding="{Binding Category}" Width="110"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding CategoryHint}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
     <DataGridTextColumn x:Name="SourceColumn" Header="{local:Tr 'Source'}" Binding="{Binding BagName}" Width="120"/>
     <DataGridTextColumn x:Name="OwnerColumn" Header="{local:Tr 'Owner'}" Binding="{Binding OwnerText}" Width="140"/>
     <DataGridTextColumn Header="{local:Tr 'ui.slot'}" Binding="{Binding Item.Slot}" Width="60"/>
     <DataGridTextColumn Header="{local:Tr 'Stack'}" Binding="{Binding Item.Quantity}" Width="60"/>
     <DataGridTextColumn Header="{local:Tr 'Enchant'}" Binding="{Binding EnchantText}" Width="85"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource success}"/><Style.Triggers><DataTrigger Binding="{Binding Item.EnchantLevel}" Value="{x:Null}"><Setter Property="Foreground" Value="{DynamicResource text_dim}"/></DataTrigger></Style.Triggers></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
     <DataGridTextColumn Header="{local:Tr 'tab.sockets'}" Binding="{Binding SocketText}" Width="90"/>
     <DataGridTextColumn x:Name="EnduranceColumn" Header="{local:Tr 'Endurance'}" Binding="{Binding ActualEndurance}" Width="70"/>
     <DataGridTextColumn x:Name="SharpnessColumn" Header="{local:Tr 'Sharpness'}" Binding="{Binding Item.Sharpness}" Width="70"/>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Text="" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
     Visibility="{Binding IsEmpty, Converter={StaticResource BooleanVisibility}}"/>
   <GridSplitter x:Name="DetailSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>
   <ScrollViewer Background="{DynamicResource bg}" x:Name="EditorScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="16,12,16,12">
    <TextBlock Visibility="{Binding HasQuantityEditor, Converter={StaticResource BooleanVisibility}}" Text="{Binding SelectionTitle}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <Grid x:Name="DetailActions">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="ItemDetailPanel" DataContext="{Binding Detail}">
     <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <Image Source="{Binding DetailImage}" Height="150" MaxWidth="180" Stretch="Uniform"/>
     <TextBlock Text="{Binding Category}" ToolTip="{Binding CategoryHint}" Margin="0,6,0,6"/>
     <TextBlock Text="{Binding Stats}" TextWrapping="Wrap" ToolTip="{local:Tr 'Base stats at this enchant level; socket and character bonuses are excluded.'}"/>
     <TextBox Text="{Binding Description, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0,8,0,12"/>
    </StackPanel>
    <StackPanel x:Name="QuantityActions" Grid.Column="2" Visibility="{Binding HasQuantityEditor, Converter={StaticResource BooleanVisibility}}">
    <Label Content="{local:Tr 'New Stack:'}" Target="{Binding ElementName=QuantityBox}" Padding="0,0,0,6"/>
    <DockPanel>
     <StackPanel DockPanel.Dock="Right" Width="24">
      <RepeatButton Content="▴" Click="OnQuantityStep" Tag="1" Padding="0" Height="16" AutomationProperties.Name="{local:Tr 'Increase quantity'}"/>
      <RepeatButton Content="▾" Click="OnQuantityStep" Tag="-1" Padding="0" Height="16" AutomationProperties.Name="{local:Tr 'Decrease quantity'}"/>
     </StackPanel>
     <TextBox x:Name="QuantityBox" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnQuantityKey" AutomationProperties.Name="{local:Tr 'New quantity'}"/>
    </DockPanel>
    
    <Button Style="{StaticResource AccentButton}" Content="{local:Tr 'Set Stack'}" Command="{Binding ApplyCommand}"/>
    <Button Visibility="{Binding IsInventory, Converter={StaticResource BooleanVisibility}}" Foreground="{DynamicResource error}" Content="{local:Tr 'Delete Item'}" Command="{Binding DeleteCommand}" Margin="0,10,0,0"/>
    <StackPanel Visibility="{Binding IsRepurchase, Converter={StaticResource BooleanVisibility}}">
     <Button x:Name="VendorSwap" Style="{StaticResource AccentButton}" Content="{local:Tr 'Swap Selected Item'}" Command="{Binding SwapCommand}" Margin="0,10,0,0"/>
     <TextBlock Text="{local:Tr 'Swap the sold item, then repurchase it in the game.'}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
    </StackPanel>
    </StackPanel>
    <StackPanel x:Name="EnchantActions" Visibility="{Binding IsEquipment, Converter={StaticResource BooleanVisibility}}">
    <GroupBox Header="{local:Tr 'Edit Selected Equipment'}" Padding="12"><StackPanel>
    <Label Content="{local:Tr 'Enchant Level:'}" Target="{Binding ElementName=EnchantBox}" Padding="0,0,0,6"/>
    <ComboBox x:Name="EnchantBox" ItemsSource="{Binding EnchantLevels}" SelectedItem="{Binding EnchantLevel}" ItemStringFormat="+{0}" Padding="8,6" AutomationProperties.Name="{local:Tr 'Enchant level'}"/>
    <Button Style="{StaticResource AccentButton}" Content="{local:Tr 'Set Enchant'}" Command="{Binding EnchantCommand}" Margin="0,8,0,0"/>
    <TextBlock Text="{Binding EnchantHint}" TextWrapping="Wrap" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
    </StackPanel></GroupBox></StackPanel>
    <StackPanel x:Name="SocketActions" Grid.Column="2" Visibility="{Binding IsEquipment, Converter={StaticResource BooleanVisibility}}">
    <TextBlock Text="{local:Tr 'Abyss Gears'}" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding SocketInfo}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,8"/>
    <StackPanel Visibility="{Binding HasSocketEditor, Converter={StaticResource BooleanVisibility}}">
    <Label Content="{local:Tr 'Unlocked sockets'}" Target="{Binding ElementName=SocketCountBox}" Padding="0,0,0,6"/>
    <ListBox x:Name="SocketCountBox" ItemsSource="{Binding SocketOptions}" DisplayMemberPath="Count" SelectedValuePath="Count" SelectedValue="{Binding UnlockedSockets}" AutomationProperties.Name="{local:Tr 'Unlocked sockets'}" BorderThickness="0">
     <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="IsEnabled" Value="{Binding Enabled}"/><Setter Property="Padding" Value="12,5"/><Setter Property="Margin" Value="0,0,3,0"/></Style></ListBox.ItemContainerStyle>
    </ListBox>
    <TextBlock Text="{Binding SocketPreview}" Margin="0,6,0,0"/>
    <Button Style="{StaticResource AccentButton}" Content="{local:Tr 'Apply unlocked count'}" Command="{Binding UnlockSocketsCommand}" Margin="0,8,0,12"/>
    <ItemsControl ItemsSource="{Binding SocketRows}">
     <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,8">
      <TextBlock Text="{Binding Label}"/>
      <ComboBox IsEnabled="{Binding IsEditable}" ItemsSource="{Binding Choices}" SelectedValuePath="Key" DisplayMemberPath="Name" SelectedValue="{Binding SelectedKey}" AutomationProperties.Name="{Binding Label}" MaxDropDownHeight="300"/>
      <DockPanel Margin="0,4,0,0" IsEnabled="{Binding IsEditable}">
       <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Width="110" Margin="0,0,6,0" AutomationProperties.Name="{local:Tr 'Gear category'}"/>
       <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="{local:Tr 'Search Abyss Gears'}" AutomationProperties.Name="{local:Tr 'Search Abyss Gears'}"/>
      </DockPanel>
     </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button Style="{StaticResource AccentButton}" Content="{local:Tr 'Apply sockets'}" Command="{Binding SocketsCommand}"/>
    </StackPanel>
    </StackPanel>
    </Grid>
   </StackPanel>
   </ScrollViewer>
  </Grid>
  <Grid Grid.Row="3" Visibility="{Binding IsBackups, Converter={StaticResource BooleanVisibility}}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,12">
    <local:PageHeader Title="{local:Tr tab.backup}" HelpTopic="tab.backup" LoadCommand="{Binding RefreshBackupsCommand}" LoadedState="{Binding HasDocument}"/><TextBlock Text="{local:Tr 'Restoring a backup replaces the saved file on disk.'}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8"/><TextBlock Text="{local:Tr backup.reference_hint}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding BackupCount}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
   </StackPanel>
   <Grid x:Name="BackupArea" Grid.Row="1" SizeChanged="OnBackupAreaSizeChanged"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="0"/><RowDefinition Height="0"/></Grid.RowDefinitions>
    <ListBox x:Name="BackupList" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" DisplayMemberPath="Label" IsEnabled="{Binding CanEditSelection}" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{local:Tr 'Backups for the current save'}"/>
    <GridSplitter x:Name="BackupSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>
    <ScrollViewer x:Name="BackupActions" Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel Margin="16,8,16,8" MinWidth="248">
     <TextBlock Text="{local:Tr 'backup.selected_actions'}" Margin="0,0,0,8"/>
     <Button Style="{StaticResource AccentButton}" Content="{local:Tr 'Restore Selected'}" Command="{Binding RestoreBackupCommand}"/>
     <Button Content="{local:Tr 'Delete Selected'}" Command="{Binding DeleteBackupCommand}" Margin="0,8,0,0"/>
     <Separator Margin="0,16,0,16"/>
     <TextBlock Text="{local:Tr 'backup.create_actions'}" Margin="0,0,0,8"/>
     <Button Content="{local:Tr 'Backup to Local Folder'}" Command="{Binding LocalBackupCommand}"/>
     <Button Content="{local:Tr 'Set Current as PRISTINE'}" Command="{Binding PristineCommand}" Margin="0,8,0,0"/>
    </StackPanel></ScrollViewer>
   </Grid>
   <Button Grid.Row="2" Content="{local:Tr 'Open Backup Folder'}" Command="{Binding OpenBackupFolderCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
  </Grid>
 </Grid>
 </DockPanel>
 </DockPanel>
</Window>
