<UserControl x:Class="SaveUltimate.App.FieldTimePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SaveUltimate.App">
 <DockPanel IsEnabled="{Binding CanEditSelection}">
  <local:PageHeader DockPanel.Dock="Top" HelpTopic="fieldtime.title" LoadedState="{Binding Clock, Converter={x:Static local:PresentConverter.Shared}}" Margin="0,0,0,12"><local:PageHeader.LoadButton><Button x:Name="LoadData" DockPanel.Dock="Right" Content="{local:Tr ui.load_data}" Command="{Binding LoadClockCommand}"/></local:PageHeader.LoadButton></local:PageHeader>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <StackPanel MaxWidth="560" HorizontalAlignment="Left">
    <GroupBox Header="{local:Tr fieldtime.current}" Padding="12">
     <StackPanel>
      <TextBlock x:Name="Current" Text="{local:Tr ui.load_prompt}" FontSize="18" FontWeight="SemiBold"/>
     </StackPanel>
    </GroupBox>
    <GroupBox x:Name="Editor" Header="{local:Tr fieldtime.target}" Padding="12" Margin="0,12,0,0" IsEnabled="False">
     <StackPanel>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="{local:Tr fieldtime.day}" Margin="0,0,0,4"/><TextBox x:Name="DayInput" TextChanged="OnInputChanged" AutomationProperties.Name="{local:Tr fieldtime.day}"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="{local:Tr fieldtime.hour}" Margin="0,0,0,4"/><TextBox x:Name="HourInput" TextChanged="OnInputChanged" AutomationProperties.Name="{local:Tr fieldtime.hour}"/></StackPanel>
       <StackPanel Grid.Column="4"><TextBlock Text="{local:Tr fieldtime.minute}" Margin="0,0,0,4"/><TextBox x:Name="MinuteInput" TextChanged="OnInputChanged" AutomationProperties.Name="{local:Tr fieldtime.minute}"/></StackPanel>
      </Grid>
      <TextBlock x:Name="Preview" TextWrapping="Wrap" Margin="0,12,0,0"/>
      <Button Style="{StaticResource AccentButton}" x:Name="Apply" Content="{local:Tr fieldtime.apply}" Click="OnApply" IsEnabled="False" HorizontalAlignment="Left" Margin="0,12,0,0"/>
     </StackPanel>
    </GroupBox>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</UserControl>
