<UserControl x:Class="SaveUltimate.App.SkillPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SaveUltimate.App">
 <UserControl.Resources>
  <ControlTemplate x:Key="NodeTemplate" TargetType="Button">
   <Grid>
    <Ellipse x:Name="Ring" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{Binding BorderThickness.Left, RelativeSource={RelativeSource TemplatedParent}}"/>
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="White"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="White"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate>
  <!-- Detail lines without content take no space, so the panel stays compact. -->
  <Style x:Key="DetailText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Grid Margin="8">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12"><local:PageHeader Title="{local:Tr skills.title}" HelpTopic="skills.title" LoadedState="{Binding Skills, Converter={x:Static local:PresentConverter.Shared}}"><local:PageHeader.LoadButton><Button x:Name="LoadData" Content="{local:Tr ui.load_data}" Command="{Binding LoadSkillsCommand}"/></local:PageHeader.LoadButton></local:PageHeader><TextBlock x:Name="Balance" TextWrapping="Wrap" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/></StackPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,8">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button Content="{local:Tr skills.reset_view}" Click="OnReset" Margin="8,0,8,0"/>
    <Button Content="{local:Tr skills.fit}" Click="OnFit"/>
   </StackPanel>
   <ComboBox x:Name="Filter" SelectedIndex="0" SelectionChanged="OnFilter" Width="130" Margin="0,0,8,0" AutomationProperties.Name="{local:Tr 'Skill filter'}">
    <ComboBoxItem Content="{local:Tr skills.all}"/><ComboBoxItem Content="{local:Tr skills.watch}"/>
   </ComboBox>
   <TextBox x:Name="Search" TextChanged="OnSearch" AutomationProperties.Name="{local:Tr 'Search skill names'}" ToolTip="{local:Tr 'Search skill names'}"/>
  </DockPanel>
  <WrapPanel Grid.Row="2" Margin="0,0,0,8">
   <TextBlock Text="{local:Tr '+ Available   * Changed   ◉ Observed   ◎ Not observed'}" Margin="0,0,16,0"/>
   <TextBlock x:Name="Counts"/>
  </WrapPanel>
  <Grid x:Name="Split" Grid.Row="3" SizeChanged="OnSplitSize">
   <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="0"/><RowDefinition Height="0"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
   <Border x:Name="Viewport" Background="#202733" ClipToBounds="True" MinHeight="200"
     MouseWheel="OnWheel" MouseLeftButtonDown="OnPanStart" MouseLeftButtonUp="OnPanEnd" MouseMove="OnPanMove"
     ToolTip="{local:Tr 'Drag empty space to pan · Use the mouse wheel to zoom'}">
    <Canvas x:Name="Tree" HorizontalAlignment="Left" VerticalAlignment="Top"/>
   </Border>
   <GridSplitter x:Name="Splitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>
   <ScrollViewer x:Name="Details" Grid.Column="2" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="14,4">
     <ComboBox x:Name="Related" SelectionChanged="OnRelated" DisplayMemberPath="Name" AutomationProperties.Name="{local:Tr 'Related skills'}" Margin="0,0,0,8"/>
     <Image x:Name="Icon" Width="64" Height="64" HorizontalAlignment="Left"/>
     <TextBlock x:Name="Title" Text="{local:Tr skills.select}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,4"/>
     <WrapPanel Margin="0,0,0,4">
      <TextBlock x:Name="Current" VerticalAlignment="Center" Margin="0,0,8,4"/>
      <Border x:Name="ObserveBadge" CornerRadius="9" Padding="8,1" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,0,4" Visibility="Collapsed"><TextBlock x:Name="ObserveText" FontSize="12"/></Border>
     </WrapPanel>
     <TextBlock x:Name="WatchSummary" Style="{StaticResource DetailText}" FontSize="12" Margin="0,0,0,8"/>
     <TextBox x:Name="Description" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,4,0,0"/>
     <TextBlock x:Name="Requirements" Style="{StaticResource DetailText}" Margin="0,12,0,0"/>
     <TextBlock x:Name="Preview" Style="{StaticResource DetailText}" Margin="0,12,0,0"/>
     <Button Style="{StaticResource AccentButton}" x:Name="Invest" Content="{local:Tr skills.apply}" Click="OnInvest" Margin="0,12,0,0"/>
     <Button Style="{StaticResource AccentButton}" x:Name="Watch" Content="{local:Tr skills.watch_apply}" Click="OnWatch" Margin="0,12,0,0"/>
     <TextBlock x:Name="WatchPreview" Style="{StaticResource DetailText}" Margin="0,12,0,0"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Grid>
</UserControl>
