<UserControl x:Class="SaveUltimate.App.SkillPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SaveUltimate.App">
 <Grid IsEnabled="{Binding CanEditSelection}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <local:PageHeader HelpTopic="skills.title" LoadedState="{Binding Skills, Converter={x:Static local:PresentConverter.Shared}}"><local:PageHeader.LoadButton><Button x:Name="LoadData" Content="{local:Tr ui.load_data}" Command="{Binding LoadSkillsCommand}"/></local:PageHeader.LoadButton>
   <TextBlock Text="{local:Tr skills.character}" Style="{StaticResource FilterLabel}"/>
   <ComboBox x:Name="OwnerFilter" Style="{StaticResource FilterBox}" HorizontalAlignment="Left" SelectionChanged="OnFilterChanged" AutomationProperties.Name="{local:Tr skills.character}"/>
  </local:PageHeader>
  <DockPanel Grid.Row="1" Style="{StaticResource CountRow}">
   <Button Style="{StaticResource BulkButton}" x:Name="ObserveAll" DockPanel.Dock="Right" Content="{local:Tr skills.observe_all}" Click="OnObserveAll" IsEnabled="False"/>
   <TextBlock x:Name="Count" Text="{local:Tr ui.load_prompt}" Style="{StaticResource CountText}"/>
  </DockPanel>
  <local:DetailSplit Grid.Row="2">
   <DataGrid x:Name="Rows" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="OnSelectionChanged">
    <DataGrid.Columns>
     <DataGridTextColumn Header="{local:Tr skills.name}" Binding="{Binding Name}" Width="*" MinWidth="180"/>
     <DataGridTextColumn Header="{local:Tr skills.character}" Binding="{Binding Owner}" Width="Auto" MinWidth="90"/>
     <DataGridTextColumn Header="{local:Tr skills.where}" Binding="{Binding Where}" Width="Auto" MinWidth="90"/>
     <DataGridTextColumn Header="{local:Tr skills.learned}" Binding="{Binding LearnedText}" SortMemberPath="Learned" Width="Auto" MinWidth="80"/>
     <DataGridTextColumn Header="{local:Tr skills.observed_state}" Binding="{Binding ObservedText}" SortMemberPath="Done" Width="Auto" MinWidth="100" ElementStyle="{StaticResource StatusText}"/>
    </DataGrid.Columns>
   </DataGrid>
   <ScrollViewer x:Name="Details" Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="12,0,0,0">
    <StackPanel>
     <Image x:Name="Icon" Width="64" Height="64" HorizontalAlignment="Left" Margin="0,0,0,8"/>
     <TextBlock x:Name="SelectedTitle" Text="{local:Tr skills.select}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <TextBlock x:Name="Description" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <Button Style="{StaticResource AccentButton}" x:Name="ObserveSelected" Content="{local:Tr skills.observe_selected}" Click="OnObserveSelected" IsEnabled="False" Margin="0,6"/>
    </StackPanel>
   </ScrollViewer>
  </local:DetailSplit>
 </Grid>
</UserControl>
