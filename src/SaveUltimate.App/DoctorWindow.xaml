<Window x:Class="SaveUltimate.App.DoctorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:SaveUltimate.App" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Window.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource panel}"/><Setter Property="BorderBrush" Value="{DynamicResource border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/></Style>
  <!-- Each state keeps its own mark and word, so color is never the only signal. -->
  <Style x:Key="ToneCard" TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Suspect"><Setter Property="BorderBrush" Value="{DynamicResource warning}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Error"><Setter Property="BorderBrush" Value="{DynamicResource error}"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="ToneGlyph" TargetType="local:ActionGlyph" BasedOn="{StaticResource {x:Type local:ActionGlyph}}"><Setter Property="Foreground" Value="{DynamicResource text_dim}"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Ok"><Setter Property="Foreground" Value="{DynamicResource success}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Suspect"><Setter Property="Foreground" Value="{DynamicResource warning}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource error}"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="ToneDisc" TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource text_dim}"/><Setter Property="Opacity" Value="0.12"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Ok"><Setter Property="Fill" Value="{DynamicResource success}"/><Setter Property="Opacity" Value="0.16"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Suspect"><Setter Property="Fill" Value="{DynamicResource warning}"/><Setter Property="Opacity" Value="0.2"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Error"><Setter Property="Fill" Value="{DynamicResource error}"/><Setter Property="Opacity" Value="0.2"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="ToneText" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Ok"><Setter Property="Foreground" Value="{DynamicResource success}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Suspect"><Setter Property="Foreground" Value="{DynamicResource warning}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource error}"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="GroupTitle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="2,14,0,6"/></Style>
  <!-- A disc that scales with the box it is placed in. -->
  <DataTemplate x:Key="Badge"><Viewbox><Grid Width="30" Height="30"><Ellipse Style="{StaticResource ToneDisc}"/><local:ActionGlyph local:ActionGlyph.Show="True" Style="{StaticResource ToneGlyph}" Kind="{Binding Glyph}" Width="18" Height="18"/></Grid></Viewbox></DataTemplate>
 </Window.Resources>
 <Grid Margin="20">
  <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <Border Style="{StaticResource Card}">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="14,12,14,10">
     <TextBlock Text="{local:Tr ui.doctor_slots}" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding ScanText}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0"/>
    </StackPanel>
    <Button DockPanel.Dock="Bottom" Content="{local:Tr ui.doctor_open}" Click="OnBrowse" Margin="10"/>
    <ListBox x:Name="Slots" x:FieldModifier="public" SelectionChanged="OnSlotSelected" BorderThickness="0,1" Background="Transparent" Padding="6,4" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
     <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource GroupTitle}" Margin="8,8,0,4"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
     <ListBox.ItemTemplate><DataTemplate>
      <DockPanel ToolTip="{Binding Path}">
       <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Badge}" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center" Focusable="False"/>
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding SavedAt}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
      </DockPanel>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Border>

  <DockPanel Grid.Column="2">
   <Border DockPanel.Dock="Top" Style="{StaticResource ToneCard}" Padding="18,14">
    <DockPanel>
     <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Badge}" Width="60" Height="60" Margin="0,0,16,0" Focusable="False"/>
     <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Counts}" VerticalAlignment="Center" Focusable="False">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <StackPanel Margin="14,0,0,0" MinWidth="44">
        <TextBlock Text="{Binding Count}" Style="{StaticResource ToneText}" FontSize="{DynamicResource TitleSize}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding Label}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center"/>
       </StackPanel>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="{Binding Verdict}" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding FilePath}" ToolTip="{Binding FilePath}" Style="{StaticResource SecondaryText}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
    </DockPanel>
   </Border>

   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,2,0,0">
    <StackPanel Margin="0,0,4,0">
     <TextBlock Text="{local:Tr ui.doctor_problems}" Style="{StaticResource GroupTitle}" Visibility="{Binding HasIssues, Converter={StaticResource BooleanVisibility}}"/>
     <ItemsControl ItemsSource="{Binding Issues}" Focusable="False">
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border Style="{StaticResource ToneCard}" Padding="12,10" Margin="0,0,0,6">
        <DockPanel>
         <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Badge}" Width="30" Height="30" Margin="0,0,12,0" VerticalAlignment="Top" Focusable="False"/>
         <StackPanel>
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          <TextBlock Text="{Binding Reason}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasReason, Converter={StaticResource BooleanVisibility}}"/>
          <CheckBox Content="{Binding FixLabel}" IsChecked="{Binding Selected}" Margin="0,8,0,0" Visibility="{Binding CanFix, Converter={StaticResource BooleanVisibility}}"/>
         </StackPanel>
        </DockPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
      <ItemsControl.ItemTemplate><DataTemplate>
       <StackPanel>
        <TextBlock Text="{Binding Name}" Style="{StaticResource GroupTitle}"/>
        <ItemsControl ItemsSource="{Binding Checks}" Focusable="False">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate><DataTemplate>
          <Border Style="{StaticResource ToneCard}" Padding="10,8" Margin="0,0,6,6" ToolTip="{Binding Name}">
           <DockPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Badge}" Width="30" Height="30" Margin="0,0,10,0" Focusable="False"/>
            <StackPanel VerticalAlignment="Center">
             <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
             <TextBlock Text="{Binding State}" Style="{StaticResource ToneText}"/>
            </StackPanel>
           </DockPanel>
          </Border>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </ScrollViewer>
  </DockPanel>

  <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="RestoreButton" Content="{local:Tr ui.doctor_restore}" Click="OnRestore" Style="{StaticResource DangerButton}" Margin="0,0,6,0" Visibility="{Binding CanRestore, Converter={StaticResource BooleanVisibility}}"/>
    <Button Content="{local:Tr Close}" Click="OnClose" IsCancel="True" Margin="0,0,6,0"/>
    <Button x:Name="RepairButton" Content="{local:Tr ui.doctor_repair}" Click="OnRepair" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanRepair}" Visibility="{Binding HasFixes, Converter={StaticResource BooleanVisibility}}"/>
   </StackPanel>
   <TextBlock Text="{local:Tr ui.doctor_note}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
  </DockPanel>
 </Grid>
</Window>
