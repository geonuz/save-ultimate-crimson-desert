<UserControl x:Class="SaveUltimate.App.CollectionPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SaveUltimate.App">
 <Grid IsEnabled="{Binding CanEditSelection}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <local:PageHeader HelpTopic="collection.title" LoadedState="{Binding Collection, Converter={x:Static local:PresentConverter.Shared}}"><local:PageHeader.LoadButton><Button x:Name="LoadData" Content="{local:Tr ui.load_data}" Command="{Binding LoadCollectionCommand}"/></local:PageHeader.LoadButton></local:PageHeader>
  <DockPanel Grid.Row="1" Style="{StaticResource CountRow}">
   <CheckBox x:Name="Learn" DockPanel.Dock="Right" Content="{local:Tr collection.learn}" IsChecked="True" Click="OnLearnChanged" VerticalAlignment="Center" Margin="12,0,0,0"/>
   <TextBlock x:Name="Count" Text="{local:Tr ui.load_prompt}" Style="{StaticResource CountText}"/>
  </DockPanel>
  <!-- Laid out like the map's places tab: classes on the left, the items of the selected classes on the right, each table with its action below. -->
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="440*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="850*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="{local:Tr collection.class}" FontWeight="Bold" Margin="0,0,0,8"/>
   <DataGrid x:Name="Categories" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="OnCategoriesSelected">
    <DataGrid.Columns>
     <DataGridTextColumn Header="{local:Tr 'Name'}" Binding="{Binding Name}" Width="*" MinWidth="120"/>
     <DataGridTextColumn Header="{local:Tr collection.progress}" Binding="{Binding Progress}" SortMemberPath="Active" Width="Auto"/>
     <DataGridTextColumn Header="{local:Tr collection.state}" Binding="{Binding State}" SortMemberPath="Active" Width="Auto" ElementStyle="{StaticResource StatusText}"/>
    </DataGrid.Columns>
   </DataGrid>
   <Button Style="{StaticResource BulkButton}" x:Name="FillCategories" Grid.Row="2" Content="{local:Tr collection.fill_categories}" Click="OnFillCategories" IsEnabled="False" Margin="0,8,0,0"/>
   <GridSplitter Grid.Column="1" Grid.RowSpan="4" Width="6" HorizontalAlignment="Center" ResizeBehavior="PreviousAndNext"/>
   <TextBlock x:Name="Title" Grid.Column="2" Text="{local:Tr map.select_category}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <DataGrid x:Name="Rows" Grid.Column="2" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="OnRowsSelected">
    <DataGrid.Columns>
     <DataGridTextColumn Header="{local:Tr collection.name}" Binding="{Binding Name}" Width="*" MinWidth="180"/>
     <DataGridTextColumn Header="{local:Tr collection.state}" Binding="{Binding State}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource StatusText}"/>
     <DataGridTextColumn Header="{local:Tr collection.knowledge}" Binding="{Binding Knowledge}" Width="Auto" MinWidth="90"/>
    </DataGrid.Columns>
   </DataGrid>
   <Button Style="{StaticResource AccentButton}" x:Name="FillSelected" Grid.Column="2" Grid.Row="2" Content="{local:Tr collection.fill_selected}" Click="OnFillSelected" IsEnabled="False" Margin="0,8,0,0"/>
   <TextBlock x:Name="Hint" Grid.Column="2" Grid.Row="3" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
  </Grid>
 </Grid>
</UserControl>
