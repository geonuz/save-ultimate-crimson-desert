<UserControl x:Class="SaveUltimate.App.CompanionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SaveUltimate.App">
 <Grid IsEnabled="{Binding CanEditSelection}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <local:PageHeader x:Name="Header" HelpTopic="companion.title" LoadedState="{Binding Companions, Converter={x:Static local:PresentConverter.Shared}}" Margin="0,0,0,12"><local:PageHeader.LoadButton><Button x:Name="LoadData" DockPanel.Dock="Right" Content="{local:Tr ui.load_data}" Command="{Binding LoadCompanionsCommand}"/></local:PageHeader.LoadButton></local:PageHeader>
  <DockPanel Grid.Row="1">
   <!-- Resetting every name ignores the selection, so it sits with the list filter rather than the selection actions. -->
   <Button Style="{StaticResource DangerButton}" x:Name="ClearAll" DockPanel.Dock="Right" Click="OnClearAll" IsEnabled="False" VerticalAlignment="Center"/>
   <StackPanel x:Name="GroupFilter" Orientation="Horizontal"><TextBlock Text="{local:Tr 'Category:'}" VerticalAlignment="Center"/><ComboBox x:Name="Group" DisplayMemberPath="Label" MinWidth="260" SelectionChanged="OnGroup"/></StackPanel>
   <!-- Pets and mounts keep one order per category, so each category is its own tab. -->
   <TabControl x:Name="GroupTabs" DisplayMemberPath="Label" SelectionChanged="OnGroup" Visibility="Collapsed"><TabControl.ContentTemplate><DataTemplate/></TabControl.ContentTemplate></TabControl>
  </DockPanel>
  <TextBlock x:Name="Count" Grid.Row="2" Margin="0,8"/>
  <local:DetailSplit Grid.Row="3">
   <DataGrid x:Name="Rows" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="OnSelect">
    <DataGrid.Columns>
     <DataGridTemplateColumn Width="40"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding Icon}" Width="32" Height="32"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="{local:Tr 'Default Name'}" Binding="{Binding Name}" Width="*" MinWidth="140"/>
     <DataGridTextColumn Header="{local:Tr companion.key}" Binding="{Binding Record.Key}" Width="100"/>
     <DataGridTextColumn Header="{local:Tr companion.number}" Binding="{Binding Record.Number}" Width="110"/>
     <DataGridTextColumn x:Name="CustomColumn" Header="{local:Tr 'Custom Name'}" Binding="{Binding Custom}" Width="150"/>
     <DataGridTextColumn Header="{local:Tr Category}" Binding="{Binding Category}" Width="Auto" MinWidth="140"/>
     <DataGridTextColumn x:Name="RoleColumn" Header="{local:Tr companion.role}" Binding="{Binding Role}" Width="Auto" MinWidth="130"/>
     <DataGridTextColumn x:Name="LevelColumn" Header="{local:Tr companion.level_column}" Binding="{Binding Level}" Width="70"/>
    </DataGrid.Columns>
    <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Hint}"/></Style></DataGrid.RowStyle>
   </DataGrid>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock x:Name="SelectedTitle" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <StackPanel x:Name="NameButtons">
     <Button Style="{StaticResource AccentButton}" x:Name="Rename" Content="{local:Tr 'Rename Selected'}" Click="OnRename" IsEnabled="False"/>
     <Button Style="{StaticResource DangerButton}" x:Name="Clear" Content="{local:Tr 'Clear Name'}" Click="OnClear" IsEnabled="False" Margin="0,8"/>
     <StackPanel x:Name="OrderButtons" Margin="0,8,0,0">
      <Button x:Name="MoveUp" Content="{local:Tr companion.move_up}" Click="OnMove" IsEnabled="False"/>
      <Button x:Name="MoveDown" Content="{local:Tr companion.move_down}" Click="OnMove" IsEnabled="False" Margin="0,8"/>
     </StackPanel>
    </StackPanel>
    <StackPanel x:Name="CompanionPanel">
     <TextBlock x:Name="Details" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <Button Style="{StaticResource AccentButton}" x:Name="AddRobot" Content="{local:Tr companion.robot_add}" Click="OnAddRobot" IsEnabled="False"/>
     <Button Style="{StaticResource DangerButton}" x:Name="RemoveRobot" Content="{local:Tr companion.robot_remove}" Click="OnRemoveRobot" IsEnabled="False" Margin="0,8"/>
     <TextBlock Text="{local:Tr companion.robot_hint}" TextWrapping="Wrap" Style="{StaticResource SecondaryText}"/>
    </StackPanel>
   </StackPanel></ScrollViewer>
  </local:DetailSplit>
 </Grid>
</UserControl>
