<UserControl x:Class="SaveUltimate.App.MapFragmentsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SaveUltimate.App">
 <Grid IsEnabled="{Binding CanEditSelection}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <local:PageHeader x:Name="Header" HelpTopic="map.group_fragments" LoadedState="{Binding Map, Converter={x:Static local:PresentConverter.Shared}}"><local:PageHeader.LoadButton><Button x:Name="LoadData" Content="{local:Tr ui.load_data}" Command="{Binding LoadMapCommand}"/></local:PageHeader.LoadButton>
   <TextBlock Text="{local:Tr 'filter.state'}" Style="{StaticResource FilterLabel}"/>
   <ComboBox x:Name="StateFilter" Style="{StaticResource FilterBox}" SelectedIndex="0" SelectionChanged="OnFilterChanged" AutomationProperties.Name="{local:Tr 'filter.state'}">
    <ComboBoxItem Content="{local:Tr 'All'}"/><ComboBoxItem Content="{local:Tr 'map.state_active'}"/><ComboBoxItem Content="{local:Tr 'map.state_inactive'}"/>
   </ComboBox>
   <Label Content="{local:Tr 'Search:'}" Target="{Binding ElementName=Search}" Margin="0,0,12,0"/>
   <TextBox x:Name="Search" Tag="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" TextChanged="OnSearchChanged" ToolTip="{local:Tr map.search_fragments}" AutomationProperties.Name="{local:Tr map.search_fragments}"/>
  </local:PageHeader>
  <DockPanel Grid.Row="1" Style="{StaticResource CountRow}">
   <Button Style="{StaticResource BulkButton}" x:Name="ActivateAll" DockPanel.Dock="Right" Content="{local:Tr map.activate_all}" Click="OnActivateAll" IsEnabled="False"/>
   <TextBlock x:Name="Count" Text="{local:Tr map.load_prompt}" Style="{StaticResource CountText}"/>
  </DockPanel>
  <local:DetailSplit Grid.Row="2">
   <DataGrid x:Name="Rows" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="OnSelectionChanged"
    EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
    <DataGrid.Columns>
     <DataGridTextColumn Header="{local:Tr 'Name'}" Binding="{Binding Name}" Width="*" MinWidth="200"/>
     <DataGridTextColumn Header="{local:Tr 'Internal Name'}" Binding="{Binding InternalName}" Width="*" MinWidth="120"/>
     <DataGridTextColumn Header="{local:Tr 'filter.state'}" Binding="{Binding State}" SortMemberPath="Done" Width="Auto" MinWidth="90" ElementStyle="{StaticResource StatusText}"/>
    </DataGrid.Columns>
   </DataGrid>
   <ScrollViewer x:Name="Details" Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="12,0,0,0">
    <StackPanel>
     <TextBlock x:Name="SelectedTitle" Text="{local:Tr ui.select_item}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <TextBlock x:Name="Summary" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <Button Style="{StaticResource AccentButton}" x:Name="ActivateSelected" Content="{local:Tr map.activate_selected}" Click="OnActivateSelected" IsEnabled="False"/>
    </StackPanel>
   </ScrollViewer>
  </local:DetailSplit>
 </Grid>
</UserControl>
