<UserControl x:Class="SaveUltimate.App.ChallengePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SaveUltimate.App">
 <UserControl.Resources>
  <Style x:Key="StatusText" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource warning}"/>
   <Style.Triggers><DataTrigger Binding="{Binding Done}" Value="True"><Setter Property="Foreground" Value="{DynamicResource success}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="TreeExpander" TargetType="ToggleButton">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border Background="Transparent" Width="19">
     <Path x:Name="Arrow" Data="M 0,0 L 5,4 L 0,8 Z" Fill="{DynamicResource text_dim}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform/></Path.RenderTransform></Path>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid IsEnabled="{Binding CanEditSelection}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <local:PageHeader Title="{local:Tr Challenges}" HelpTopic="Challenges" LoadedState="{Binding Challenges, Converter={x:Static local:PresentConverter.Shared}}" Margin="0,0,0,12"><local:PageHeader.LoadButton><Button x:Name="LoadData" DockPanel.Dock="Right" Content="{local:Tr ui.load_data}" Command="{Binding LoadChallengesCommand}"/></local:PageHeader.LoadButton></local:PageHeader>
  <DockPanel Grid.Row="1">
   <CheckBox x:Name="Incomplete" Content="{local:Tr challenge.incomplete}" DockPanel.Dock="Right" Margin="12,0,0,0" Checked="OnFilter" Unchecked="OnFilter"/>
   <TextBox x:Name="Search" TextChanged="OnSearch" ToolTip="{local:Tr challenge.search}" AutomationProperties.Name="{local:Tr challenge.search}"/>
  </DockPanel>
  <TextBlock x:Name="Count" Grid.Row="2" Margin="0,8" Text="{local:Tr challenge.load_prompt}" TextWrapping="Wrap"/>
  <Grid Grid.Row="3">
   <Grid.ColumnDefinitions><ColumnDefinition Width="440*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="850*"/></Grid.ColumnDefinitions>
   <DockPanel Grid.IsSharedSizeScope="True">
    <Grid DockPanel.Dock="Top" Margin="4,0,22,6">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto" SharedSizeGroup="Counts"/><ColumnDefinition Width="Auto" SharedSizeGroup="States"/></Grid.ColumnDefinitions>
     <TextBlock Text="{local:Tr Challenges}"/>
     <!-- Canvas keeps long translated headers ("Completed / Total") from widening the shared columns; the text overflows left instead. -->
     <Canvas Grid.Column="1"><TextBlock Canvas.Right="8" Text="{local:Tr challenge.count}"/></Canvas><TextBlock Grid.Column="2" Text="{local:Tr Status}" Margin="8,0"/>
    </Grid>
    <!-- The default TreeViewItem keeps headers at text width; stretch them so the count/status columns line up. -->
    <TreeView x:Name="Tree" SelectedItemChanged="OnSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
      <Setter Property="IsExpanded" Value="{Binding Expanded, Mode=TwoWay}"/><Setter Property="IsSelected" Value="{Binding Selected, Mode=TwoWay}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem">
       <StackPanel>
        <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
         <DockPanel><ToggleButton x:Name="Expander" Style="{StaticResource TreeExpander}" ClickMode="Press" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/><ContentPresenter ContentSource="Header"/></DockPanel>
        </Border>
        <ItemsPresenter x:Name="Items" Margin="19,0,0,0"/>
       </StackPanel>
       <ControlTemplate.Triggers>
        <Trigger Property="IsExpanded" Value="False"><Setter TargetName="Items" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource selected}"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
     </Style></TreeView.ItemContainerStyle>
     <TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding Children}">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto" SharedSizeGroup="Counts"/><ColumnDefinition Width="Auto" SharedSizeGroup="States"/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" MinWidth="80"/>
       <TextBlock Grid.Column="1" Text="{Binding Count}" Margin="8,0" HorizontalAlignment="Right"/><TextBlock Grid.Column="2" Text="{Binding Status}" Margin="8,0" Style="{StaticResource StatusText}"/>
      </Grid>
     </HierarchicalDataTemplate></TreeView.ItemTemplate>
    </TreeView>
   </DockPanel>
   <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
   <Grid Grid.Column="2" Margin="10,0,0,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="Title" Text="{local:Tr challenge.select}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <DataGrid x:Name="Rows" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"
      EnableRowVirtualization="True" SelectionChanged="OnRowsSelected">
     <DataGrid.Columns>
      <DataGridTextColumn Header="{local:Tr challenge.role}" Binding="{Binding Role}"/>
      <DataGridTextColumn Header="{local:Tr Key}" Binding="{Binding Key}"/>
      <DataGridTextColumn Header="{local:Tr challenge.objective}" Binding="{Binding Name}" Width="*" MinWidth="140">
       <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding InternalName}"/></Style></DataGridTextColumn.ElementStyle>
      </DataGridTextColumn>
      <DataGridTextColumn Header="{local:Tr Status}" Binding="{Binding Status}" ElementStyle="{StaticResource StatusText}"/>
      <DataGridTextColumn Header="{local:Tr Progress}" Binding="{Binding Progress}"/>
     </DataGrid.Columns>
    </DataGrid>
    <TextBlock x:Name="DetailNote" Grid.Row="2" TextWrapping="Wrap" Margin="0,8"/>
    <Button Style="{StaticResource AccentButton}" x:Name="CompleteSelected" Grid.Row="3" Content="{local:Tr challenge.complete_selected}" IsEnabled="False" Click="OnCompleteSelected" ToolTip="{local:Tr challenge.select_checkpoint}"/>
    <Button Style="{StaticResource BulkButton}" x:Name="CompleteAll" Grid.Row="4" Content="{local:Tr challenge.complete_all}" IsEnabled="False" Click="OnCompleteAll" Margin="0,8"/>
    <TextBlock x:Name="EditNote" Grid.Row="5" Text="{local:Tr challenge.select}" TextWrapping="Wrap"/>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
