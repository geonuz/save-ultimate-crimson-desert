<UserControl x:Class="SaveUltimate.App.MapPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SaveUltimate.App">
 <Grid IsEnabled="{Binding CanEditSelection}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <local:PageHeader Title="{local:Tr map.title}" HelpTopic="map.title" LoadedState="{Binding Map, Converter={x:Static local:PresentConverter.Shared}}" Margin="0,0,0,12"><local:PageHeader.LoadButton><Button x:Name="LoadData" DockPanel.Dock="Right" Content="{local:Tr ui.load_data}" Command="{Binding LoadMapCommand}"/></local:PageHeader.LoadButton></local:PageHeader>
  <GroupBox Header="{local:Tr map.fog}" Grid.Row="1" Margin="0,0,0,12"><StackPanel Margin="12">
   <DockPanel><Button Style="{StaticResource AccentButton}" x:Name="Reveal" DockPanel.Dock="Right" Content="{local:Tr map.reveal}" ToolTip="{local:Tr map.reveal_hint}" Command="{Binding RevealMapCommand}" IsEnabled="False"/><TextBlock x:Name="FogStatus" Text="{local:Tr map.load_prompt}"/></DockPanel>
   <TextBlock Text="{local:Tr map.fog_hint}" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </StackPanel></GroupBox>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid x:Name="Cards" SizeChanged="OnCardsSizeChanged">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="LeftCards"/><StackPanel x:Name="RightCards" Grid.Column="2"/>
   </Grid>
  </ScrollViewer>
 </Grid>
</UserControl>
