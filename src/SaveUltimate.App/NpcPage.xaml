<UserControl x:Class="SaveUltimate.App.NpcPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SaveUltimate.App">
 <Grid IsEnabled="{Binding CanEditSelection}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <local:PageHeader Title="{local:Tr npc.title}" HelpTopic="npc.title" LoadedState="{Binding Friendship, Converter={x:Static local:PresentConverter.Shared}}" Margin="0,0,0,12"><local:PageHeader.LoadButton><Button x:Name="LoadData" DockPanel.Dock="Right" Content="{local:Tr ui.load_data}" Command="{Binding LoadFriendshipCommand}"/></local:PageHeader.LoadButton></local:PageHeader>
  <TextBox Tag="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" x:Name="Search" Grid.Row="1" TextChanged="OnSearch" ToolTip="{local:Tr npc.search}" AutomationProperties.Name="{local:Tr npc.search}"/>
  <TextBlock x:Name="Count" Grid.Row="2" Margin="0,8"/>
  <local:DetailSplit Grid.Row="3">
   <DataGrid x:Name="Rows" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="OnSelect">
    <DataGrid.Columns>
     <DataGridTextColumn Header="{local:Tr Name}" Binding="{Binding Name}" Width="*" MinWidth="130"/>
     <DataGridTextColumn Header="{local:Tr npc.area}" Binding="{Binding Area}" Width="Auto" MinWidth="140"/>
     <DataGridTextColumn Header="{local:Tr npc.role}" Binding="{Binding Service}" Width="Auto" MinWidth="120"/>
     <DataGridTextColumn Header="{local:Tr npc.value}" Binding="{Binding Value}" Width="Auto" MinWidth="70"/>
     <DataGridTextColumn Header="{local:Tr Status}" Binding="{Binding Status}" Width="Auto" MinWidth="100"/>
    </DataGrid.Columns>
    <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Title}"/></Style></DataGrid.RowStyle>
   </DataGrid>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock x:Name="SelectedTitle" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,12"/>
    <TextBlock Text="{local:Tr npc.new_value}"/>
    <ComboBox x:Name="Value" SelectionChanged="OnValue" IsEnabled="False" Margin="0,6"/>
    <Button Style="{StaticResource AccentButton}" x:Name="Apply" Content="{local:Tr npc.apply}" IsEnabled="False" Click="OnApply"/>
    <TextBlock x:Name="Hint" TextWrapping="Wrap" Margin="0,8"/>
   </StackPanel></ScrollViewer>
  </local:DetailSplit>
 </Grid>
</UserControl>
