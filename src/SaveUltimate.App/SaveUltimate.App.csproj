<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>SaveUltimate</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../resources/assets/app_icon.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- The analyzer pulls ILLink.Tasks into the locked restore; the app does not use Assembly.Location. -->
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compacts the large-object heap holding save and Undo buffers; lowered peak memory about 18% in UI measurements. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <AssemblyMetadata Include="GameVersion" Value="$(GameVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <ProjectReference Include="../SaveUltimate.Core/SaveUltimate.Core.csproj" />
    <Content Include="../../resources/data/knowledge_keys_all.json;../../resources/data/knowledge_details.json;../../resources/data/item_names.json;../../resources/data/item_details.json;../../resources/data/character_names.json;../../resources/data/store_names.json;../../resources/data/socket_gems.json;../../resources/data/template_keys.json" Link="resources/data/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../resources/locale/*.json" Link="resources/locale/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../resources/data/ui_themes.json;../../resources/data/ui_icons.json" Link="resources/data/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="../../resources/assets/fonts/hahmlet/*.ttf" Link="fonts/%(Filename)%(Extension)" />
    <Content Include="../../LICENSE;../../LICENSES.md;../../licenses/*.txt" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../resources/data/npc_catalog.json" Link="resources/data/npc_catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../resources/assets/skill-generic.svg" Link="resources/assets/skill-generic.svg" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="../../resources/assets/app_icon.ico" Link="app_icon.ico" />
  </ItemGroup>
</Project>
