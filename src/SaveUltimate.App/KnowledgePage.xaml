<UserControl x:Class="SaveUltimate.App.KnowledgePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SaveUltimate.App">
 <Grid IsEnabled="{Binding CanEditSelection}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <local:PageHeader HelpTopic="tab.knowledge" LoadedState="{Binding Knowledge, Converter={x:Static local:PresentConverter.Shared}}"><local:PageHeader.LoadButton><Button x:Name="LoadData" Content="{local:Tr ui.load_data}" Command="{Binding LoadKnowledgeCommand}" DockPanel.Dock="Right"/></local:PageHeader.LoadButton>
   <TextBlock Text="{local:Tr 'Category'}" Style="{StaticResource FilterLabel}"/>
   <ComboBox x:Name="Root" Style="{StaticResource FilterBox}" DisplayMemberPath="Label" SelectionChanged="OnRootChanged" AutomationProperties.Name="{local:Tr 'Category'}"/>
   <TextBlock Text="{local:Tr 'Subcategory'}" Style="{StaticResource FilterLabel}"/>
   <ComboBox x:Name="Subcategory" Style="{StaticResource FilterBox}" DisplayMemberPath="Label" SelectionChanged="OnFilterChanged" AutomationProperties.Name="{local:Tr 'Subcategory'}"/>
   <TextBlock Text="{local:Tr 'filter.state'}" Style="{StaticResource FilterLabel}"/>
   <ComboBox x:Name="State" Style="{StaticResource FilterBox}" SelectedIndex="0" SelectionChanged="OnFilterChanged" AutomationProperties.Name="{local:Tr 'filter.state'}">
    <ComboBoxItem Content="{local:Tr 'All'}"/><ComboBoxItem Content="{local:Tr 'Learned'}"/><ComboBoxItem Content="{local:Tr 'Unlearned'}"/>
   </ComboBox>
   <Label Content="{local:Tr 'Search:'}" Target="{Binding ElementName=Search}" Margin="0,0,12,0"/>
   <TextBox Tag="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" x:Name="Search" TextChanged="OnSearchChanged" AutomationProperties.Name="{local:Tr 'Search name, key or category'}" ToolTip="{local:Tr 'Search name, key or category'}"/>
  </local:PageHeader>
  <DockPanel Grid.Row="1" Style="{StaticResource CountRow}">
   <Button Style="{StaticResource BulkButton}" x:Name="AllMaximum" Content="{local:Tr 'Learn All Knowledge &amp;&amp; Apply Maximum Levels'}" Click="OnAllMaximum" DockPanel.Dock="Right" IsEnabled="False"/>
   <TextBlock x:Name="Count" Text="{local:Tr 'Load knowledge to continue.'}" Style="{StaticResource CountText}"/>
  </DockPanel>
  <local:DetailSplit Grid.Row="2">
   <DataGrid x:Name="Rows" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"
    EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionChanged="OnSelectionChanged">
    <DataGrid.ContextMenu><ContextMenu>
     <MenuItem Header="{local:Tr 'Learn Selected'}" Click="OnLearn"/><MenuItem Header="{local:Tr 'Unlearn Selected'}" Click="OnUnlearn"/>
     <MenuItem Header="{local:Tr 'Copy Key(s)'}" Click="OnCopy"/>
    </ContextMenu></DataGrid.ContextMenu>
    <DataGrid.Columns>
     <DataGridTextColumn Header="{local:Tr 'Display Name'}" Binding="{Binding Name}" Width="1.5*" MinWidth="140"/>
     <DataGridTextColumn Header="{local:Tr 'Status'}" Binding="{Binding Status}" ElementStyle="{StaticResource StatusText}"/>
     <DataGridTextColumn Header="{local:Tr 'Knowledge Level'}" Binding="{Binding LevelText}" SortMemberPath="Level"/>
     <DataGridTextColumn Header="{local:Tr 'Category'}" Binding="{Binding Category}" Width="*" MinWidth="100"/>
     <DataGridTextColumn Header="{local:Tr 'Key'}" Binding="{Binding Key}"/>
     <DataGridTextColumn Header="{local:Tr 'Internal Name'}" Binding="{Binding InternalLabel}" Width="*" MinWidth="100">
      <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding InternalName}"/></Style></DataGridTextColumn.ElementStyle>
     </DataGridTextColumn>
    </DataGrid.Columns>
   </DataGrid>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="12,0,0,0">
    <StackPanel>
     <TextBlock x:Name="SelectedTitle" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <TextBlock x:Name="Description" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <Button x:Name="Learn" Style="{StaticResource AccentButton}" Content="{local:Tr 'Learn Selected'}" Click="OnLearn" IsEnabled="False"/>
     <Button Style="{StaticResource DangerButton}" x:Name="Unlearn" Content="{local:Tr 'Unlearn Selected'}" Click="OnUnlearn" IsEnabled="False" Margin="0,6"/>
     <TextBlock Text="{local:Tr 'Knowledge Level:'}" Margin="0,12,0,4"/>
     <ComboBox x:Name="Level" IsEnabled="False"/>
     <Button x:Name="Apply" Style="{StaticResource AccentButton}" Content="{local:Tr 'Apply Knowledge Level'}" Click="OnApply" IsEnabled="False" Margin="0,6"/>
     <Button x:Name="Maximum" Style="{StaticResource AccentButton}" Content="{local:Tr 'Apply Maximum Level'}" Click="OnMaximum" IsEnabled="False"/>
     <TextBlock x:Name="Hint" TextWrapping="Wrap" Margin="0,8"/>
    </StackPanel>
   </ScrollViewer>
  </local:DetailSplit>
 </Grid>
</UserControl>
