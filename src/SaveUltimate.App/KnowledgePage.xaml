<UserControl x:Class="SaveUltimate.App.KnowledgePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SaveUltimate.App">
 <Grid IsEnabled="{Binding CanEditSelection}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <local:PageHeader HelpTopic="tab.knowledge" LoadedState="{Binding Knowledge, Converter={x:Static local:PresentConverter.Shared}}"><local:PageHeader.LoadButton><Button x:Name="LoadData" Content="{local:Tr ui.load_data}" Command="{Binding LoadKnowledgeCommand}"/></local:PageHeader.LoadButton>
   <TextBlock Text="{local:Tr 'filter.state'}" Style="{StaticResource FilterLabel}"/>
   <ComboBox x:Name="State" Style="{StaticResource FilterBox}" SelectedIndex="0" SelectionChanged="OnFilterChanged" AutomationProperties.Name="{local:Tr 'filter.state'}">
    <ComboBoxItem Content="{local:Tr 'All'}"/><ComboBoxItem Content="{local:Tr 'Learned'}"/><ComboBoxItem Content="{local:Tr 'Unlearned'}"/>
   </ComboBox>
   <Label Content="{local:Tr 'Search:'}" Target="{Binding ElementName=Search}" Margin="0,0,12,0"/>
   <TextBox Tag="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" x:Name="Search" TextChanged="OnSearchChanged" AutomationProperties.Name="{local:Tr 'Search name, key or category'}" ToolTip="{local:Tr 'Search name, key or category'}"/>
  </local:PageHeader>
  <DockPanel Grid.Row="1" Style="{StaticResource CountRow}">
   <TextBlock x:Name="Count" Text="{local:Tr 'Load knowledge to continue.'}" Style="{StaticResource CountText}"/>
  </DockPanel>
  <!-- Laid out like the challenges page: journal categories on the left, the entries of the selected one on the right,
       and like the map's places tab each side keeps its action below its table. -->
  <Grid Grid.Row="2" Grid.IsSharedSizeScope="True">
   <Grid.ColumnDefinitions><ColumnDefinition Width="400*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="900*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="4,0,22,8">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto" SharedSizeGroup="Counts"/><ColumnDefinition Width="Auto" SharedSizeGroup="States"/></Grid.ColumnDefinitions>
     <TextBlock Text="{local:Tr 'Category'}" FontWeight="Bold"/>
     <Canvas Grid.Column="1"><TextBlock Canvas.Right="8" Text="{local:Tr knowledge.count_header}"/></Canvas><TextBlock Grid.Column="2" Text="{local:Tr Status}" Margin="8,0"/>
    </Grid>
    <TreeView x:Name="Tree" Grid.Row="1" SelectedItemChanged="OnGroupSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" ItemContainerStyle="{StaticResource TableTreeItem}" AutomationProperties.Name="{local:Tr 'Category'}">
     <TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding Children}">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto" SharedSizeGroup="Counts"/><ColumnDefinition Width="Auto" SharedSizeGroup="States"/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" MinWidth="80"/>
       <TextBlock Grid.Column="1" Text="{Binding Count}" Margin="8,0" HorizontalAlignment="Right"/><TextBlock Grid.Column="2" Text="{Binding Status}" Margin="8,0" Style="{StaticResource StatusText}"/>
      </Grid>
     </HierarchicalDataTemplate></TreeView.ItemTemplate>
    </TreeView>
   <Button Style="{StaticResource BulkButton}" x:Name="AllMaximum" Grid.Row="2" Content="{local:Tr 'Learn All Knowledge &amp;&amp; Apply Maximum Levels'}" Click="OnAllMaximum" IsEnabled="False" Margin="0,8,0,0" VerticalAlignment="Top" ToolTip="{local:Tr knowledge.all_maximum_hint}"/>
   <GridSplitter Grid.Column="1" Grid.RowSpan="3" Width="6" HorizontalAlignment="Center" ResizeBehavior="PreviousAndNext"/>
   <TextBlock x:Name="Title" Grid.Column="2" Text="{local:Tr map.select_category}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <DataGrid x:Name="Rows" Grid.Column="2" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"
    EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionChanged="OnSelectionChanged">
    <DataGrid.ContextMenu><ContextMenu>
     <MenuItem Header="{local:Tr 'Learn Selected'}" Click="OnLearn"/><MenuItem Header="{local:Tr 'Unlearn Selected'}" Click="OnUnlearn"/>
     <MenuItem Header="{local:Tr 'Copy Key(s)'}" Click="OnCopy"/>
    </ContextMenu></DataGrid.ContextMenu>
    <DataGrid.Columns>
     <DataGridTextColumn Header="{local:Tr 'Display Name'}" Binding="{Binding Name}" Width="1.5*" MinWidth="140">
      <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Description}"/><Setter Property="ToolTipService.ShowDuration" Value="20000"/></Style></DataGridTextColumn.ElementStyle>
     </DataGridTextColumn>
     <DataGridTextColumn Header="{local:Tr 'Status'}" Binding="{Binding Status}" ElementStyle="{StaticResource StatusText}"/>
     <DataGridTextColumn Header="{local:Tr 'Knowledge Level'}" Binding="{Binding LevelText}" SortMemberPath="Level"/>
     <DataGridTextColumn Header="{local:Tr 'Category'}" Binding="{Binding Category}" Width="*" MinWidth="100"/>
     <DataGridTextColumn Header="{local:Tr 'Key'}" Binding="{Binding Key}"/>
     <DataGridTextColumn Header="{local:Tr 'Internal Name'}" Binding="{Binding InternalLabel}" Width="*" MinWidth="100">
      <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding InternalName}"/></Style></DataGridTextColumn.ElementStyle>
     </DataGridTextColumn>
    </DataGrid.Columns>
   </DataGrid>
   <!-- Selection actions under the table: learn or unlearn any selection, levels for learned entries. -->
   <StackPanel Grid.Column="2" Grid.Row="2" Margin="0,8,0,0">
    <TextBlock x:Name="Description" TextWrapping="Wrap" MaxHeight="72" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" Visibility="Collapsed"/>
    <WrapPanel>
     <Button x:Name="Learn" Style="{StaticResource AccentButton}" Content="{local:Tr 'Learn Selected'}" Click="OnLearn" IsEnabled="False" Margin="0,0,8,8"/>
     <Button Style="{StaticResource DangerButton}" x:Name="Unlearn" Content="{local:Tr 'Unlearn Selected'}" Click="OnUnlearn" IsEnabled="False" Margin="0,0,16,8"/>
     <Label Content="{local:Tr 'Knowledge Level:'}" Target="{Binding ElementName=Level}" Margin="0,0,8,8"/>
     <ComboBox x:Name="Level" IsEnabled="False" MinWidth="72" Margin="0,0,8,8" AutomationProperties.Name="{local:Tr 'Knowledge Level'}"/>
     <Button x:Name="Apply" Style="{StaticResource AccentButton}" Content="{local:Tr 'Apply Knowledge Level'}" Click="OnApply" IsEnabled="False" Margin="0,0,8,8"/>
     <Button x:Name="Maximum" Style="{StaticResource AccentButton}" Content="{local:Tr 'Apply Maximum Level'}" Click="OnMaximum" IsEnabled="False" Margin="0,0,0,8"/>
    </WrapPanel>
    <TextBlock x:Name="Hint" TextWrapping="Wrap" Style="{StaticResource SecondaryText}"/>
   </StackPanel>
  </Grid>
 </Grid>
</UserControl>
